; "Formulae Evaluation" 1023-6-MA6 from
; 520-600 Series General Program Library Vol1
;
; f00 = CLEAR
; f01 = [+]	level 7 op 1
; f02 = [-]	level 7 op 2
; f03 = [*]	level 12 op 1
; f04 = [/]	level 12 op 2
; f05 = [^]	level 27
; f06 = [(]	++level
; f07 = [)]	compute...
; f08 = [=]	final total
;
; Register usage:
;	R0	index to current working value (INDIR <op>00)
;		temp: for ALPHA compares
;	R4	temp, current value
;	R5	parenthesis nesting (0..4)
;	R6	temp, current value
;	R7..11	add/sub by paren level
;	R12..16	mult/div by paren level
;	R17..21	current total by paren level
;	R22..26	power by paren level
	.DEF	$kclr	f00
	.DEF	$kplus	f01
	.DEF	$kminus	f02
	.DEF	$ktimes	f03
	.DEF	$kdivide	f04
	.DEF	$kpower	f05
	.DEF	$klparen	f06
	.DEF	$krparen	f07
	.DEF	$kequal	f08
	.DEF	$none1	f09	; reserve unused labels
	.DEF	$none2	f10
	.DEF	$none3	f11
	.DEF	$none4	f12
	.DEF	$none5	f13
	.DEF	$none6	f14
	.DEF	$none7	f15

	; fudge to match orig program
	.DEF	&no_add	E1
	.DEF	&do_sub	E2
	.DEF	&do_add	E3

MARK $kclr	; the CLEAR key
	ENTER 4
	ST00
MARK &clr0
	ENTER 1
	+00
	$zero_cur
	ENTER 31	; 27+5 (-1)
	ALPHA JIF0
		SEARCH &clr0
	CLEAR
	RET

MARK $kplus	; the [+] key
	$comp_pwr_mlt
	$comp_add
	ENTER 7
	$set_idx
	ENTER 1
	$set_cur
	RET

MARK $kminus	; the [-] key
	$comp_pwr_mlt
	$comp_add
	ENTER 7
	$set_idx
	ENTER 2
	$set_cur
	RET

MARK $ktimes	; the [*] key
	$comp_pwr_mlt
	ENTER 12
	$set_idx
	ENTER 1
	$set_cur
	RET

MARK $kdivide	; the [/] key
	$comp_pwr_mlt
	ENTER 12
	$set_idx
	ENTER 2
	$set_cur
	RET

MARK $kpower	; the [^] key
	ST04
	ENTER 27
	$set_idx
	RE04
	$set_cur
	RET

MARK $klparen	; the [(] key
	ENTER 1
	+05
	RET

MARK $krparen	; the [)] key
	$comp_pwr_mlt
	$comp_add
	ENTER 17
	$set_idx	; set level 17
	INDIR RE00
	ST04	; current sum
	ENTER 7
	$set_idx
	$zero_cur	; zero val (7)
	ENTER 5
	+00
	$zero_cur	; zero val (12)
	ENTER 5
	+00
	$zero_cur	; zero val (17)
	ENTER 5
	+00
	$zero_cur	; zero val (22)
	ENTER 1
	-05
	RE04	; current sum
	RET

MARK $kequal	; the [=] key
	ST04
	RE05	; paren nesting
	JIF0
		ENTER 0	; unbalanced parens
		/00
	RE04
	$comp_pwr_mlt
	$comp_add
	RECALL 17
	RET

; Internal functions
MARK $comp_add	; compute add/sub
	ENTER 7
	$set_idx
	INDIR RE00
	JIFNZ
		SEARCH &no_add
	ST00
	ENTER 1
	ALPHA JIF0
		SEARCH &do_sub
MARK &do_add
	$pop_idx22
	INDIR +00
	SEARCH &add_done
MARK &do_sub
	$pop_idx22
	INDIR -00
	SEARCH &add_done
MARK &no_add
	ENTER 12
	$set_idx
	INDIR RE00
	JIF0
		SEARCH &do_add
	ENTER 5
	+00
	RE04
	INDIR +00
MARK &add_done
	ENTER 12
	$set_idx
	$zero_cur
	ENTER 10
	+00
	$zero_cur
	RET

MARK $comp_pwr_mlt	; compute power/mult
	ST04
	ENTER 27
	$set_idx	; set level 27
	INDIR RE00
	JIFNZ
		SEARCH &no_pwr
	LOGX
	*04
	10^X
	ST04	; save X^Y
	$zero_cur	; zero val (27)
MARK &no_pwr
	ENTER 12
	$set_idx	; set level 12
	INDIR RE00	; get current mult op
	JIF0
		SEARCH &do_mlt
	$set_idx22	; set level 22
	RE04
	$set_cur	; store in (level)
	RET
MARK &do_mlt
	ST00
	ENTER 1
	ALPHA JIF0
		SEARCH &do_div
	$set_idx22	; set level 22
	RE04
	INDIR *00	// multiplication
	RET
MARK &do_div
	$set_idx22
	RE04
	INDIR /00	// division
	RET

MARK $set_idx	; ser curr idx and incr by R5
	ST00
	RE05
	+00
	RET

MARK $set_idx22	; set idx 22+R5
	ENTER 22
	$set_idx
	RET

MARK $pop_idx22
	$set_idx22
	INDIR RE00
	ST06
	ENTER 5
	-00
	RE06
	RET

MARK $zero_cur	; zero curr val
	ENTER 0
MARK $set_cur	; store X in curr val
	INDIR ST00
	CLEAR
	RET

	END
