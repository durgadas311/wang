/* ../craps.wng */

#include "wang600.h"

FLABEL(rand)
FLABEL(roll_dice)
LABEL(new_game)
LABEL(lose)
LABEL(win)
LABEL(try_point)
LABEL(no_funds)

#define seed	7
#define compare	0
#define bank	1
#define bet	2
#define roll	3
#define temp2	14
#define temp	15

IREG_DATA(blank,"fffffffffffff00a")

BEGIN()
	ST(seed)
	ENTER(500)
	ST(bank)
MARK(new_game)
	RE(bank)
	STOP()
	ST(bet)
	RE(bank)
	ST(temp)
	RE(bet)
	SUB(temp)
	J_IF_P()
	SEARCH(no_funds)
	FCALL(roll_dice)
	ST(compare)
	PAUSE()
	PAUSE()
	ENTER(12)
	J_IF_NE()
	SEARCH(lose)
	ENTER(2)
	J_IF_NE()
	SEARCH(lose)
	ENTER(3)
	J_IF_NE()
	SEARCH(lose)
	ENTER(7)
	J_IF_NE()
	SEARCH(win)
	ENTER(11)
	J_IF_NE()
	SEARCH(win)

MARK(try_point)
	FCALL(roll_dice)
	PAUSE()
	PAUSE()
	J_IF_NE()
	SEARCH(win)
	ST(temp2)
	ENTER(7)
	SUB(temp2)
	J_IF_0()
	SEARCH(try_point)

MARK(lose)
	RECALL(blank)
	PAUSE()
	RE(bet)
	SUB(bank)
	SEARCH(new_game)

MARK(win)
	ENTER(0)
	INV()
	RE(compare)
	PAUSE()
	J_IF_ERR()
	GO()
	GO()
	RE(bet)
	ADD(bank)
	SEARCH(new_game)

MARK(no_funds)
	ENTER(0)
	INV()
	RE(bank)
	PAUSE()
	J_IF_ERR()
	GO()
	GO()
	SEARCH(new_game)

MARK(roll_dice)
	FCALL(rand)
	ST(temp2)
	ENTER(6)
	MULT(temp2)
	ENTER(1)
	ADD(temp2)
	INT()
	ST(roll)
	FCALL(rand)
	ST(temp2)
	ENTER(6)
	MULT(temp2)
	ENTER(1)
	ADD(temp2)
	INT()
	ADD(roll)
	RETURN()

MARK(rand)
	ENTER(1)
	ADD(seed)
	POW10(7)
	LOG_E_X()
	MULT(seed)
	INT()
	SUB(seed)
	RETURN()
END()
