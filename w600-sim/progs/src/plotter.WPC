#include "wang600.h"

// Labels:
LABEL(loop)
LABEL(end)
FLABEL(f_of_x)
FLABEL(plot_setup)
FLABEL(scale)

// Registers:
#define plotY	0
#define plotX	1
#define temp	2
#define lastX	8
#define lastY	9
#define currY	15
#define currX	14
#define maxX	13
#define stepX	12

BEGIN()
	CLEAR()
	ALPHA_STRING("\133")	// home pen
	ENTER(0)
	ST(currX)
	ENTER(360)
	ST(maxX)
	ENTER(1)
	ST(stepX)
	// do first point as "move", not "plot"
	RE(currX)
	FCALL(f_of_x)
	FCALL(scale)
	ST(currY)
	FCALL(plot_setup)
	ALPHA_STRING("\123")	// move to
	RE(stepX)
	ADD(currX)
MARK(loop)
	RE(currX)
	FCALL(f_of_x)
	FCALL(scale)
	ST(currY)
	FCALL(plot_setup)
	ALPHA_STRING("\122")	// plot to
	RE(stepX)
	ADD(currX)
	ST(temp)
	RE(maxX)
	SUB(temp)
	J_IF_P() SEARCH(loop)
	END_PROG()

MARK(plot_setup)
	RE(currX)
	ST(plotX)
	RE(lastX)
	SUB(plotX)
	RE(currY)
	ST(plotY)
	RE(lastY)
	SUB(plotY)
	RE(currX)
	ST(lastX)
	RE(currY)
	ST(lastY)
	RETURN()

MARK(f_of_x)
	SIN()
	RETURN()

MARK(scale)
	ST(temp)
	ENTER(300)
	MULT(temp)
	ENTER(600.5)
	ADD(temp)
	INT()
	RETURN()
END()
