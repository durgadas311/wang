; Random Number Generator
; derived from 1016-2-ST6 of "520-600 Series General Program Library Vol 1"
; $RAND: random number -1.0 < x < 1.0
; Usage:
;	Enter seed, call $seed
;	call $rand [...]

; setup random seed. If |X| >= 1 then use 1/|X| else use |X|
MARK $seed
	ABS
	ST07
	ENTER 1
	-07
	JIF+
		SEARCH &rnd0
	1/X
	ST07
	ENTER 1
	-07
MARK &rnd0
	ENTER 1
	+07
	RET

; compute next rand number.
; returns -1.0 < X < 1.0
MARK $rand
	RE07
	ABS
	ST07
	LNX
	*07
	E^X
	ALPHA SHX+02
	ST07
	INT
	-07
	ENTER 2
	*07
	ENTER 1
	-07
	RET
