/* ../zeller.wng */

#include "wang600.h"
#include "libw6/zeller.w6h"

FLLABEL(header)
FLLABEL(pmonth)
LLABEL(loop)
LLABEL(skip)
LLABEL(join)
LLABEL(done)
LLABEL(jan)
LLABEL(feb)
LLABEL(mar)
LLABEL(apr)
LLABEL(may)
LLABEL(jun)
LLABEL(jul)
LLABEL(aug)
LLABEL(sep)
LLABEL(oct)
LLABEL(nov)
LLABEL(dec)
LLABEL(is_leap)
LLABEL(not_leap)
LLABEL(not_cent)

// zeller uses 0-3...
#define max_day	6
#define dom	7
#define dow	4
#define feb_days 5
#define mytemp	8

BEGIN()
	ST(month)
	CLR_DISP()
	STOP()
	ST(year)
	ST(temp)
	ENTER(28)
	ST(feb_days)
	ENTER(31)
	ST(max_day)
	ENTER(100)	// check leap year... shame, zeller also does this
	DIV(temp)
	INT()
	SUB(temp)
	J_IF_0() SEARCH(not_cent)
	RE(year)
	ST(temp)
	ENTER(400)
	DIV(temp)
	INT()
	SUB(temp)
	J_IF_0() SEARCH(not_leap)
MARK(is_leap)
	ENTER(1)
	ADD(feb_days)
MARK(not_leap)
	
	FCALL(header)

	ENTER(1)
	ST(day)
	FCALL(zeller)
	J_IF_N0() E(7) GO()
	ST(mytemp)
	ENTER(2)
	EXCHG(mytemp)
	SUB(mytemp)
	ST(dom)
	ENTER(7)
	ST(dow)
MARK(loop)
	RE(dom)
	J_IF_P() SEARCH(skip)
	J_IF_N0() SEARCH(skip)
	IO(0x20)
	SEARCH(join)
MARK(skip)
	IO(0xc3)
MARK(join)
	ENTER(1)
	ADD(dom)
	RE(max_day)
	ST(mytemp)
	RE(dom)
	SUB(mytemp)
	J_IF_P() SEARCH(done)
	ENTER(1)
	SUB(dow)
	J_IF_0() SEARCH(loop)
	ALPHA_STRING("\r")
	ENTER(7)
	ST(dow)
	SEARCH(loop)
MARK(done)
	ALPHA_STRING("\r")
	END_PROG()

MARK(not_cent)
	RE(year)
	ST(temp)
	ENTER(4)
	DIV(temp)
	INT()
	SUB(temp)
	J_IF_0() SEARCH(not_leap)
	SEARCH(is_leap)

MARK(header)
	RE(month)
	FCALL(pmonth)	// 9 chars
	IO(0xc7)	// 7 spaces
	RE(year)
	IO(0x40)	// 4 digit year + 1 = 21 chars
	ALPHA_STRING("\r  S  M  T  W  T  F  S\r")
	RETURN();

MARK(pmonth)
	ST(temp)
	ENTER(1)
	SUB(temp)
	ENTER(2)
	MULT(temp)
	JUMP(temp)
	SEARCH(jan)
	SEARCH(feb)
	SEARCH(mar)
	SEARCH(apr)
	SEARCH(may)
	SEARCH(jun)
	SEARCH(jul)
	SEARCH(aug)
	SEARCH(sep)
	SEARCH(oct)
	SEARCH(nov)
	SEARCH(dec)
	// overflow? could land anywhere...

MARK(jan)
	ALPHA_STRING("January  ")
	// 31 days, already set
	RETURN()
MARK(feb)
	ALPHA_STRING("February ")
	RE(feb_days)
	ST(max_day)
	RETURN()
MARK(mar)
	ALPHA_STRING("March    ")
	// 31 days, already set
	RETURN()
MARK(apr)
	ALPHA_STRING("April    ")
	ENTER(1)
	SUB(max_day)
	RETURN()
MARK(may)
	ALPHA_STRING("May      ")
	// 31 days, already set
	RETURN()
MARK(jun)
	ALPHA_STRING("June     ")
	ENTER(1)
	SUB(max_day)
	RETURN()
MARK(jul)
	ALPHA_STRING("July     ")
	// 31 days, already set
	RETURN()
MARK(aug)
	ALPHA_STRING("August   ")
	// 31 days, already set
	RETURN()
MARK(sep)
	ALPHA_STRING("September")
	ENTER(1)
	SUB(max_day)
	RETURN()
MARK(oct)
	ALPHA_STRING("October  ")
	// 31 days, already set
	RETURN()
MARK(nov)
	ALPHA_STRING("November ")
	ENTER(1)
	SUB(max_day)
	RETURN()
MARK(dec)
	ALPHA_STRING("December ")
	// 31 days, already set
	RETURN()

END()
