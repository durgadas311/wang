/* ../zeller.wng */

#include "wang600.h"
#include "libw6/zeller.w6h"

FLLABEL(header)
FLLABEL(pmonth)
LLABEL(jan)
LLABEL(feb)
LLABEL(mar)
LLABEL(apr)
LLABEL(may)
LLABEL(jun)
LLABEL(jul)
LLABEL(aug)
LLABEL(sep)
LLABEL(oct)
LLABEL(nov)
LLABEL(dec)

BEGIN()
	ST(month)
	CLR_DISP()
	STOP()
	ST(year)
	FCALL(header)

	ENTER(1)
	ST(day)
	FCALL(zeller)
	IO(0x10)
	ALPHA_STRING("\r")
	END_PROG()

MARK(header)
	RE(month)
	FCALL(pmonth)	// 9 chars
	IO(0xc7)	// 7 spaces
	RE(year)
	IO(0x40)	// 4 digit year + 1 = 21 chars
	ALPHA_STRING("\r  S  M  T  W  T  F  S\r")
	RETURN();

MARK(pmonth)
	ST(temp)
	ENTER(1)
	SUB(temp)
	ENTER(2)
	MULT(temp)
	JUMP(temp)
	SEARCH(jan)
	SEARCH(feb)
	SEARCH(mar)
	SEARCH(apr)
	SEARCH(may)
	SEARCH(jun)
	SEARCH(jul)
	SEARCH(aug)
	SEARCH(sep)
	SEARCH(oct)
	SEARCH(nov)
	SEARCH(dec)
	// overflow? could land anywhere...

MARK(jan)
	ALPHA_STRING("January  ")
	RETURN()
MARK(feb)
	ALPHA_STRING("February ")
	RETURN()
MARK(mar)
	ALPHA_STRING("March    ")
	RETURN()
MARK(apr)
	ALPHA_STRING("April    ")
	RETURN()
MARK(may)
	ALPHA_STRING("May      ")
	RETURN()
MARK(jun)
	ALPHA_STRING("June     ")
	RETURN()
MARK(jul)
	ALPHA_STRING("July     ")
	RETURN()
MARK(aug)
	ALPHA_STRING("August   ")
	RETURN()
MARK(sep)
	ALPHA_STRING("September")
	RETURN()
MARK(oct)
	ALPHA_STRING("October  ")
	RETURN()
MARK(nov)
	ALPHA_STRING("November ")
	RETURN()
MARK(dec)
	ALPHA_STRING("December ")
	RETURN()

// accessed as an array from "jan_len" (how?)
IREG_DATA(dec_len,31)
IREG_DATA(nov_len,30)
IREG_DATA(oct_len,31)
IREG_DATA(sep_len,30)
IREG_DATA(aug_len,31)
IREG_DATA(jul_len,31)
IREG_DATA(jun_len,30)
IREG_DATA(may_len,31)
IREG_DATA(apr_len,30)
IREG_DATA(mar_len,31)
IREG_DATA(feb_len,28)
IREG_DATA(jan_len,31)

END()
