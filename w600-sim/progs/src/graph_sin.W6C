#include "wang600.h"

#include "libplot/plotter.w6h"

EXTERNAL(setup_point)

BEGIN()
	CLEAR()
	ENTER(0)
	STORE(startX)
	ENTER(360)
	STORE(maxX)
	ENTER(5)
	STORE(stepX)
	ENTER(1)	// scaling in X
	STORE(scaleX)
	ENTER(500)	// scaling in Y
	STORE(scaleY)
	ENTER(0)	// translation in X
	STORE(tranX)
	ENTER(500)	// translation in Y
	STORE(tranY)

	FCALL(grapher)

	ENTER(0)
	ST(convX)
	ENTER(-1)
	ST(convY)
	CALL(setup_point)
	ALPHA_STRING("|y = SIN(x)")
	END_PROG()

MARK(GRAPHING_FUNCTION)
	SIN()
	RETURN()

MARK(GRAPHING_PLOT)
	// exchange X,Y since we are plotting down-page...
	RE(plotX)
	EXCHG(plotY)
	ST(plotX)
	ALPHA_STRING("|o")	// plot "o"
	RETURN()

END()
