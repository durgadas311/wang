; Plot a list of data points on the flatbed plotter.
; Requires the "libplot" ROM.
; Uses load_tape_data to get data points into reigsters.

	.INCLUDE	libplot.w6h

	CLRALL
	ENTER 23	; starting register of array
	CALL &load_tape_data	; into R23..
	JIF+
		SEARCH &exit	; error
	ENTER 23
	STORE 16	; first register
	RE00
	STORE 17	; last register
	ENTER 5
	STORE 21	; X scale
	ENTER 10
	STORE 22	; Y scale
	ENTER 40
	STORE 19	; X base
	ENTER 200
	STORE 20	; Y base
	$plot_data
	RECALL 17
	ST02
	RECALL 16
	-02
	STORE 17	; number of registers, X axis length
	ENTER 0
	STORE 16	; starting X
	ENTER 8
	STORE 18	; step for X (tic interval)
	ENTER 0
	ST10		; base for X
	$plot_Xaxis
	ENTER 15-
	STORE 16	; starting Y
	ENTER 6
	STORE 17	; ending Y
	ENTER 5
	STORE 18	; step for Y (tic interval)
	ENTER 0
	ST11		; base for Y
	$plot_Yaxis
	ENTER 2
	$plot_chrsize
	ENTER 0
	ST14
	ENTER 17-
	ST15
	$pt_scale
	$plot_move	; position for title
	ALPHA "outdoor temp, deg c"
	SEARCH &exit

	.INCLUDE	load_tape_data.w6i

MARK &exit
	END
