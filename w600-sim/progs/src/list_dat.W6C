#include "wang600.h"
#include "libplot/plotter.w6h"
#include "libw6/load_tape_data.w6h"

EXTERNAL(load_tape_data)
LLABEL(loop)

#define startIX	15
#define maxIX	14
#define mytemp1	13
#define mytemp2	12

BEGIN()
	CLEAR()
	ENTER(16)
	CALL(load_tape_data)
	J_IF_P() END_PROG()
	RE(top_reg)
	ST(maxIX)
	ENTER(16)
	SUB(maxIX)
	ENTER(0)
	ST(startIX)

	ALPHA_STRING("Outdoor Temp, Deg. C\r")

	ALPHA_STRING("Sample  Time  Temp\r");
	ALPHA_STRING("------  ----  -------\r");
MARK(loop)
	RE(startIX)
	IO(0x30)
	IO(0xc3)

	RE(startIX)
	ST(mytemp1)
	ENTER(15)
	MULT(mytemp1)
	ENTER(60)
	DIV(mytemp1)
	INT()
	ST(mytemp2)
	SUB(mytemp1)
	ENTER(60)
	MULT(mytemp1)
	RE(mytemp2)
	POW10(2)
	ADD(mytemp1)
	IO(0x40)

	RE(startIX)
	ST(mytemp1)
	ENTER(16)
	ADD(mytemp1)
	INDIR(RE(mytemp1))
	IO(0x43)
	ALPHA_STRING("\r")

	RE(maxIX)
	ST(mytemp1)
	ENTER(1)
	ADD(startIX)
	SUB(mytemp1)
	J_IF_P() END_PROG()
	SEARCH(loop)
END()
