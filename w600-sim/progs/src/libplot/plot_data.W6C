#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

// Registers:
#define currX	startX

FLABEL(plot_data)
FEXTERNAL(plot_chrsize)
FEXTERNAL(scale_Y)
FEXTERNAL(translate)
FEXTERNAL(plot_moveabs)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop)

BEGIN()
MARK(plot_data)
	// do first point as "move", not "plot"
	INDIR(RE(currX))
	FCALL(scale_Y)
	ST(currY)
	CALL(setup_point)
	FCALL(translate) // translate first point only, rest are relative
	FCALL(plot_moveabs)
	ENTER(1)
	ADD(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop)
	INDIR(RE(currX))
	FCALL(scale_Y)
	ST(currY)
	CALL(setup_point)
	FCALL(plot_drawto)
	ENTER(1)
	ADD(currX)
	ST(temp1)
	RE(maxX)
	SUB(temp1)
	J_IF_P() SEARCH(loop)
	ENTER(3)	// or let user set size?
	FCALL(plot_chrsize)
	CALL(DESCRIPTION_FUNCTION)
	RETURN()
END()
