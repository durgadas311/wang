#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plot_data)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop)

BEGIN()
MARK(plot_data)
	// do first point as "move", not "plot"
	FCALL(plot_home)
	RE(startX)
	ST(currX)
	ENTER(0)
	ST(convX)
	INDIR(RE(currX))
	ST(convY)
	CALL(setup_point) // last should be (0,0)
	FCALL(plot_moveto)
	ENTER(1)
	ADD(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop)
	RE(currX)
	ST(convX)
	RE(startX)
	SUB(convX) // data idx "0", not actual register number
	INDIR(RE(currX))
	ST(convY)
	CALL(setup_point)
	FCALL(plot_drawto)
	ENTER(1)
	ADD(currX)
	ST(temp1)
	RE(maxX)
	SUB(temp1)
	J_IF_P() SEARCH(loop)
	RETURN()
END()
