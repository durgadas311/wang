#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plot_Yaxis)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LABEL(loop7)
LABEL(skip_org)
FLABEL(plot_tic2)

BEGIN()
MARK(plot_Yaxis)
	ENTER(1)
	FCALL(plot_chrsize) // so we know label offsets...
	ENTER(4)
	MULT(plotX)	// label width
	ST(temp8) // hope no one trashes this...
	RE(plotY)
	ST(temp7)
	ENTER(2)
	DIV(temp7)

	// do first point as "move", not "plot"
	FCALL(plot_home)
	T(lastX)
	T(lastY)
	RECALL(startX)
	ST(currY)
	ST(convY)
	RE(currX)
	ST(convX)
	CALL(setup_point)
	FCALL(plot_moveto)
	FCALL(plot_tic2)
	RECALL(stepX)
	ADD(currY)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop7)
	RE(currY)
	ST(convY)
	RE(currX)
	ST(convX)
	CALL(setup_point)
	FCALL(plot_drawto)
	FCALL(plot_tic2)
	RECALL(maxX)
	ST(temp1)
	RECALL(stepX)
	ADD(currY)
	SUB(temp1)
	J_IF_P() RETURN() GO()
	SEARCH(loop7)

MARK(plot_tic2)
	T(plotY)
	ENTER(-5)	// scale?
	ST(plotX)
	FCALL(plot_drawto)
	RE(currY)
	J_IF_N0() SEARCH(skip_org)
	RE(temp8)
	CHANGE_SIGN()
	ST(plotX)
	RE(temp7)
	CHANGE_SIGN()
	ST(plotY)
	FCALL(plot_moveto)
	RE(currY)
	IO(0x30)
MARK(skip_org)
	FCALL(plot_home)
	RE(lastX)
	ST(plotX)
	RE(lastY)
	ST(plotY)
	FCALL(plot_moveto)
	RETURN()
END()
