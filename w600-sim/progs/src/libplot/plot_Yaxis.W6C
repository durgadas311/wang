#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plot_Yaxis)
FLLABEL(plot_tic)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop)
LLABEL(skip_org)

BEGIN()
MARK(plot_Yaxis)
	// do first point as "move", not "plot"
	FCALL(plot_home)
	T(lastX)
	T(lastY)
	RE(startX)
	ST(currY)
	ST(convY)
	RE(currX)
	ST(convX)
	CALL(setup_point)
	FCALL(plot_moveto)
	FCALL(plot_tic)
	RE(stepX)
	ADD(currY)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop)
	RE(currY)
	ST(convY)
	RE(currX)
	ST(convX)
	CALL(setup_point)
	FCALL(plot_drawto)
	FCALL(plot_tic)
	RE(stepX)
	ADD(currY)
	ST(temp1)
	RE(maxX)
	SUB(temp1)
	J_IF_P() SEARCH(loop)
	RETURN()

MARK(plot_tic)
	T(plotY)
	ENTER(-5)	// scale?
	ST(plotX)
	FCALL(plot_drawto)
	RE(currY)
	J_IF_N0() SEARCH(skip_org)
	IO(0x30)
MARK(skip_org)
	FCALL(plot_home)
	RE(lastX)
	ST(plotX)
	RE(lastY)
	ST(plotY)
	FCALL(plot_moveto)
	RETURN()
END()
