; Plot data points from registers.
; Data already acquired and set must fit in memory.
;
; Input params:
; R16 = starting register number for Y data (>= 23).
; R17 = number of data points
; R19 = base X offset (not used directly)
; R20 = base Y offset (not used directly)
; R21 = X scale (not used directly)
; R22 = Y scale (not used directly)

; Uses regs:
; R00 = (implied for all plotting)
; R01 = (implied for all plotting)
; R02 = temp
; R11 = current register number
; R14 = input to pt_scale: X, 0-based (R11 - R16)
; R15 = input to pt_scale: Y (regs[R11])

MARK $plot_data
	$plot_home	; known starting position
	RECALL 16
	ST11
	ENTER 0
	ST14		; X value
	INDIR RE11
	ST15		; Y data value
	$pt_scale	; scale point
	$plot_move	; move to first point
	ENTER 1
	+11
MARK &pd1
	RE11
	ST14
	RECALL 16
	-14
	INDIR RE11	; next data point
	ST15
	$pt_scale	; scale point
	$plot_draw	; draw line to next point(s)
	RECALL 17
	ST02		; temp, for compare
	ENTER 1
	+11
	-02
	JIF+
		RET	; Done.
		GO
	@SEARCH &pd1	; get another data point
