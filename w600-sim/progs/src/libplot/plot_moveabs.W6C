#include "wang600.h"

#include "plotter.w6h"

FLABEL(plot_moveabs)

BEGIN()
MARK(plot_moveabs)
	// The following in somewhat inefficient... X,Y are sent for both
	// the HOME and MOVE commands, even though they are only needed
	// for the MOVE command.
	ALPHA_PLOT("\h\^")	// home pen, move to absolute coords
	RETURN()
END()
