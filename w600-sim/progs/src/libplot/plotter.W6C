#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plotter)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop)

BEGIN()
MARK(plotter)
	// do first point as "move", not "plot"
	FCALL(plot_home)
	RE(startX)
	ST(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_moveto)
	RE(stepX)
	ADD(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop)
	RE(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_drawto)
	RE(stepX)
	ADD(currX)
	ST(temp1)
	RE(maxX)
	SUB(temp1)
	J_IF_P() SEARCH(loop)
	RETURN()
END()
