#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plotter)
FEXTERNAL(scale_point)
FEXTERNAL(translate)
FEXTERNAL(plot_moveabs)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop)

BEGIN()
MARK(plotter)
	// do first point as "move", not "plot"
	RE(startX)
	ST(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	FCALL(scale_point)
	CALL(setup_point)
	FCALL(translate) // translate first point only, rest are relative
	FCALL(plot_moveabs)
	RE(stepX)
	ADD(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop)
	RE(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	FCALL(scale_point)
	CALL(setup_point)
	FCALL(plot_drawto)
	RE(stepX)
	ADD(currX)
	ST(temp1)
	RE(maxX)
	SUB(temp1)
	J_IF_P() SEARCH(loop)
	// moveabs to someplace... need better way
	ENTER(5)
	ST(convX)
	ST(convY)
	FCALL(plot_moveabs)
	CALL(DESCRIPTION_FUNCTION)
	RETURN()
END()
