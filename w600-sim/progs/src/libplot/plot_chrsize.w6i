; set character size/spacing
	.OUT	W612	; flatbed plotter

; called with size factor (1,2,...)
; spacing is 1.3x taller than width.
MARK $plot_chrsize
	ST01	; size index
	ENTER 0
	ST00
	ALPHA "\z"	; set char size
	; compute space from size index
	ENTER 1.3
	ST00
	ENTER 6
	*01	; 6 * index
	*00	; (6 * index) * 1.3
	ALPHA "\s"	; set char space
	RET
