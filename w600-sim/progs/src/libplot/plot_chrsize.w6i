; Set character size and spacing.
; Input: X = size index (1,2,3,...)
; Uses: R00, R01 (input to plot)
; Spacing is set to width=6*X, height=1.3*width
;
; It is not known how the rela plotter interpreted character
; size index. Thie simulator uses the value 1-15

	.OUT	W612	; flatbed plotter

MARK $plot_chrsize
	ST01	; size index in place for cmd
	ENTER 0
	ST00	; zero to avoid extra movement chars
	ALPHA "\z"	; set char size
	; compute spacing from size index
	; keey Y at 0 - only print left-to-right
	ENTER 6
	*01	; W = (X =) 6 * index
	ALPHA "\s"	; set char space
	RET
