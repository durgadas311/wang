#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plot_data)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop3)

BEGIN()
MARK(plot_data)
	// do first point as "move", not "plot"
	FCALL(plot_home)
	RECALL(startX)
	ST(currX)
	ENTER(0)
	ST(convX)
	INDIR(RE(currX))
	ST(convY)
	CALL(setup_point) // last should be (0,0)
	FCALL(plot_moveto)
	ENTER(1)
	ADD(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop3)
	RE(currX)
	ST(convX)
	RECALL(startX)
	SUB(convX) // data idx "0", not actual register number
	INDIR(RE(currX))
	ST(convY)
	CALL(setup_point)
	FCALL(plot_drawto)
	RECALL(maxX)
	ST(temp1)
	ENTER(1)
	ADD(currX)
	SUB(temp1)
	J_IF_P() RETURN() GO()
	SEARCH(loop3)
END()
