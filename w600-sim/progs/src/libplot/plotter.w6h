#ifndef _libplot_plotter_h_
#define _libplot_plotter_h_

///// Input param registers:
#define startX	14	//
#define maxX	13	//
#define stepX	12	// "FOR X = startX TO maxX STEP stepX..."
#define tranY	11	// translation of Y on paper
#define tranX	10	// translation of X on paper
#define scalY	9	// scaling of Y to paper
#define scalX	8	// scaling of X to paper

#define lastY	7	// internal use
#define lastX	6	// internal use
#define currX	5
#define convY	15	// internal use
#define convX	14	// internal use

#define plotY	0	// system designated - volatile
#define plotX	1	// system designated - volatile
#define temp1	2	// volatile
#define temp2	3
#define temp3	4

FEXTERNAL(plotter)
FEXTERNAL(grapher)
FEXTERNAL(plot_data)

RES_EXTERN(GRAPHING_FUNCTION,0)
RES_EXTERN(DESCRIPTION_FUNCTION,1)
RES_EXTERN(GRAPHING_PLOT,2)

#endif // _libplot_plotter_h_
