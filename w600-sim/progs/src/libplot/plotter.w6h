#ifndef _libplot_plotter_h_
#define _libplot_plotter_h_

///// Input param registers:
#define startX	13	//
#define maxX	12	//
#define stepX	11	// "FOR X = startX TO maxX STEP stepX..."
#define tranY	10	// translation of Y on paper
#define tranX	9	// translation of X on paper
#define scalY	8	// scaling of Y to paper
#define scalX	7	// scaling of X to paper

#define lastY	6	// internal use
#define lastX	5	// internal use
#define currX	4
#define currY	3
#define convY	15	// internal use
#define convX	14	// internal use

#define plotY	0	// system designated - volatile
#define plotX	1	// system designated - volatile
#define temp1	2	// volatile

FEXTERNAL(plotter)
FEXTERNAL(grapher)
FEXTERNAL(plot_data)

RES_EXTERN(GRAPHING_FUNCTION,0)
RES_EXTERN(GRAPHING_PLOT,1)

#endif // _libplot_plotter_h_
