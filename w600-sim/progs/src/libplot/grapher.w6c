#include "wang600.h"

#include "plotter.w6h"

FLABEL(grapher)
EXTERNAL(setup_point)

EXTERNAL(GRAPHING_FUNCTION)
EXTERNAL(GRAPHING_PLOT)

// Labels:
LABEL(loop2)

BEGIN()
MARK(grapher)
	T(plotX)
	T(plotY)
	ALPHA_STRING("|\r")	// set carriage to known position
	RECALL(startX)
	ST(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	CALL(setup_point)
	CALL(GRAPHING_PLOT)
	RECALL(stepX)
	ADD(currX)
MARK(loop2)
	RE(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	CALL(setup_point)
	CALL(GRAPHING_PLOT)
	RECALL(maxX)
	ST(temp1)
	RECALL(stepX)
	ADD(currX)
	SUB(temp1)
	J_IF_P() RETURN() GO()
	SEARCH(loop2)
END()
