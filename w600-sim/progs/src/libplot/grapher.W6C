#include "wang600.h"

#include "plotter.w6h"

FLABEL(grapher)
FEXTERNAL(scale_point)
FEXTERNAL(translate)
EXTERNAL(setup_point)

// Labels:
LLABEL(loop)

BEGIN()
MARK(grapher)
	T(plotX)
	T(plotY)
	ALPHA_STRING("|\r")	// set carriage to known position
	RE(startX)
	ST(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	FCALL(scale_point)
	CALL(setup_point)
	FCALL(translate)
	CALL(GRAPHING_PLOT)
	RE(stepX)
	ADD(currX)
MARK(loop)
	RE(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	FCALL(scale_point)
	CALL(setup_point)
	CALL(GRAPHING_PLOT)
	RE(stepX)
	ADD(currX)
	ST(temp1)
	RE(maxX)
	SUB(temp1)
	J_IF_P() SEARCH(loop)
	// need better way to set position for title...
	ALPHA_STRING("\r")
	CALL(DESCRIPTION_FUNCTION)
	RETURN()
END()
