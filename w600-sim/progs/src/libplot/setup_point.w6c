#include "wang600.h"

#include "plotter.w6h"

// Labels:
LABEL(setup_point)

BEGIN()
MARK(setup_point)
	// input point is (convX,convY), output is (plotX,plotY)
	// scale/translate point and compute relative change from last point
	RECALL(scaleX)
	MULT(convX) // scale X
	ENTER(0.5)
	ADD(convX)
	INT()
	ST(convX)
	ST(plotX)
	RECALL(tranX)
	ADD(plotX) // translate X
	EXCHG(lastX)
	SUB(plotX) // delta to last

	RECALL(scaleY)
	MULT(convY) // scale Y
	ENTER(0.5)
	ADD(convY)
	INT()
	ST(convY)
	ST(plotY)
	RECALL(tranY)
	ADD(plotY) // translate Y
	EXCHG(lastY)
	SUB(plotY) // delta to last

	RETURN()
END()
