#include "wang600.h"

#include "plotter.w6h"	// get out interface to the world

FLABEL(plotter)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
EXTERNAL(setup_point)

EXTERNAL(GRAPHING_FUNCTION)
EXTERNAL(GRAPHING_PLOT)

// Labels:
LABEL(loop4)

BEGIN()
MARK(plotter)
	// do first point as "move", not "plot"
	FCALL(plot_home)
	RECALL(startX)
	ST(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_moveto)
	RECALL(stepX)
	ADD(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop4)
	RE(currX)
	ST(convX)
	CALL(GRAPHING_FUNCTION)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_drawto)
	RECALL(maxX)
	ST(temp1)
	RECALL(stepX)
	ADD(currX)
	SUB(temp1)
	J_IF_P() RETURN() GO()
	SEARCH(loop4)
END()
