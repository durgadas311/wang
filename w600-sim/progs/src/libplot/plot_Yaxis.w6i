; Draw Y axis with labeled tic marks, at X=0.
; Label is un-scaled Y value.
; Input params:
; R10

; maintained by pt_scale
; R12 = last scaled X (previous X)
; R13 = last scaled Y (previous Y)
; input params to pt_scale
; R14 =
; R15 =

; R16 = starting Y
; R17 = ending Y
; R18 = step for Y (tic interval)
; R19 = base X offset
; R20 = base Y offset
; R21 = X scale
; R22 = Y scale
; 
MARK $plot_Yaxis
	ENTER 1		; character size for labels
	$plot_chrsize
	RE01
	ST08
	ENTER 4
	*01
	ST09
	ENTER 1.3
	*08
	ENTER 2
	/08		; R8, R9 = bounds of tics
	$plot_home	; always starts at (0,0)
	T12		; prev X, for pt_scale
	T13		; prev Y, for pt_scale
	RECALL 16
	ST10
	ST15
	RE11
	ST14
	$pt_scale	; updates R12,R13
	$plot_move	; set starting position
	@CALL &Y_tic	; draw Y tic
	RECALL 18
	+10
MARK &py1
	RE10
	ST15
	RE11
	ST14
	$pt_scale	; updates R12,R13
	$plot_draw	; draw to position
	@CALL &Y_tic	; draw Y tic
	RECALL 17
	ST02
	RECALL 18
	+10
	-02
	JIF+
		@SEARCH &py2
	@SEARCH &py1	; do more segments
MARK &py2
	RECALL 18
	+02
	JIFNZ
		RET
		GO
	RECALL 17	; do partial segment
	ST15
	RE11
	ST14
	$pt_scale	; updates R12,R13
	$plot_draw	; draw final partial segment
	RET

MARK &Y_tic
	T00
	ENTER 5-
	ST01
	$plot_draw		; draw tic mark
	RE10
	JIFNZ
		@SEARCH &yt1
	RE09
	CHGSGN
	ST01
	RE08
	CHGSGN
	ST00
	$plot_move	; move to label position
	RE10
	I/O 03-00	; print label/value
MARK &yt1
	; we lost our way home, so reset from (0,0)
	$plot_home	; home pen
	RE12
	ST01
	RE13
	ST00
	$plot_move	; return to prior Y axis position
	RET
