; Prints a month's calendar on the OutputWriter
; Enter month; GO; Enter year; GO

; Registers used:
;	R0 = (zeller)
;	R1 = (zeller)
;	R2 = (zeller)
;	R3 = (zeller)
;	R4 = day of week
;	R5 = FEB days
;	R6 = max day of month
;	R7 = cur day of month
;	R8 = temp

;		; enter month
	ST00
	CLEAR
	STOP	; enter year
	ST02
	ST03
	ENTER 28
	ST05
	ENTER 31
	ST06
	ENTER 100
	/03
	INT
	-03
	JIF0
		SEARCH &nocent	; if not turn of century
	RE02
	ST03
	ENTER 400	;
	/03
	INT
	-03
	JIF0
		SEARCH &noleap	; not div by 400, not leap year
MARK &leap	; leap year
	ENTER 1
	+05	; 29 days in FEB
MARK &noleap	; not leap year
	f00	; print header
	ENTER 1
	ST01	; first of month
	$zeller	; zeller - compute day of week
	JIFNZ
		ENTER 7	; convert "0" to "7"
		GO
	ST08
	ENTER 2
	EX08
	-08
	ST07	; R7 = 2 - Z
	ENTER 7
	ST04
MARK &week	; loop for printing a week
	RE07
	JIF+
		SEARCH &noday	; don't print day
	JIFNZ
		SEARCH &noday	; don't print day
	I/O 02-00	; print %2d (day)
	SEARCH &cont
MARK &noday	; don't print day
	I/O 12-03	; print "   "
MARK &cont
	ENTER 1
	+07
	RE06	; num days
	ST08
	RE07
	-08
	JIF+
		SEARCH &done	; done with month
	ENTER 1
	-04
	JIF0
		SEARCH &week	; do another day of week
	; done with week
	ALPHA "\r"
	ENTER 7
	ST04
	SEARCH &week	; do another week

MARK &done
	ALPHA "\r"
	SEARCH &exit	; end prog (exit)

; Not turn of century
MARK &nocent
	RE02
	ST03
	ENTER 4
	/03
	INT
	-03
	JIF0
		SEARCH &noleap	; not leap year
	SEARCH &leap	; leap year

; print header
MARK f00
	RE00
	$month		; print month name
	I/O 12-07	; print "       "
	RE02
	I/O 04-00	; print "%4d" (year)
	ALPHA "\r  S  M  T  W  T  F  S\r"
	RET

; print month name
MARK $month
	ST03
	ENTER 1
	-03
	ENTER 2
	*03		; R3 = (month - 1) * 2
	INDIR R03	; "switch" on R03
	SEARCH &jan	; R03 = 0
	SEARCH &feb	; R03 = 2
	SEARCH &mar	; R03 = 4
	SEARCH &apr	; R03 = 6
	SEARCH &may	; R03 = 8
	SEARCH &jun	; R03 = 10
	SEARCH &jul	; R03 = 12
	SEARCH &aug	; R03 = 14
	SEARCH &sep	; R03 = 16
	SEARCH &oct	; R03 = 18
	SEARCH &nov	; R03 = 20
	SEARCH &dec	; R03 = 22

; print the chosen month name
MARK &jan
	ALPHA "January  "
	RET
MARK &feb
	ALPHA "February "
	RE05
	ST06	; 28/29 days
	RET
MARK &mar
	ALPHA "March    "
	RET
MARK &apr
	ALPHA "April    "
	ENTER 1
	-06	; 30 days
	RET
MARK &may
	ALPHA "May      "
	RET
MARK &jun
	ALPHA "June     "
	ENTER 1
	-06	; 30 days
	RET
MARK &jul
	ALPHA "July     "
	RET
MARK &aug
	ALPHA "August   "
	RET
MARK &sep
	ALPHA "September"
	ENTER 1
	-06	; 30 days
	RET
MARK &oct
	ALPHA "October  "
	RET
MARK &nov
	ALPHA "November "
	ENTER 1
	-06	; 30 days
	RET
MARK &dec
	ALPHA "December "
	RET

	.INCLUDE	zeller.w6i

; end of program (exit)
MARK &exit
	END

