#include "wang600.h"

#include "libplot/plotter.w6h"

EXTERNAL(setup_point)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_Xaxis)

BEGIN()
	CLEAR()
	ENTER(0)
	STORE(startX)
	ENTER(360)	// make sure we plot the last point
	STORE(maxX)
	ENTER(5)
	STORE(stepX)
	ENTER(1)	// scaling in X
	STORE(scaleX)
	ENTER(200)	// scaling in Y
	STORE(scaleY)
	ENTER(10)	// translation in X
	STORE(tranX)
	ENTER(250)	// translation in Y
	STORE(tranY)
	FCALL(plotter)

	ENTER(1)
	FCALL(plot_chrsize)
	ENTER(90)
	STORE(stepX)
	ENTER(0)
	ST(currY)
	FCALL(plot_Xaxis)

	ENTER(-1)
	STORE(startX)
	ENTER(1.1)	// make sure we plot the last point
	STORE(maxX)
	ENTER(1)
	STORE(stepX)
	ENTER(0)
	ST(currX)
	FCALL(plot_Yaxis)

	ENTER(2)
	FCALL(plot_chrsize)
	ENTER(0)
	ST(convX)
	ENTER(-1.1)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_moveto)
	ALPHA_PLOT("Y = SIN{X}")
	END_PROG()

MARK(GRAPHING_FUNCTION)
	SIN()
	RETURN()
END()
