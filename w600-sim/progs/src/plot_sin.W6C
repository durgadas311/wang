#include "wang600.h"

#include "libplot/plotter.w6h"

EXTERNAL(setup_point)
FEXTERNAL(plot_moveto)

BEGIN()
	CLEAR()
	ENTER(0)
	ST(startX)
	ENTER(361)	// make sure we plot the last point
	ST(maxX)
	ENTER(5)
	ST(stepX)
	ENTER(1)	// scaling in X
	ST(scalX)
	ENTER(200)	// scaling in Y
	ST(scalY)
	ENTER(10)	// translation in X
	ST(tranX)
	ENTER(210)	// translation in Y
	ST(tranY)

	FCALL(plotter)

	ENTER(0)
	ST(convX)
	ENTER(-1)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_moveto)
	ALPHA_PLOT("Y = SIN{X}")
	END_PROG()

MARK(GRAPHING_FUNCTION)
	SIN()
	RETURN()
END()
