; Approximation of "Formula Programming" ROM
	.OUT	W601
;
; Errors:
;	+01	stack overflow
;	+02	implied multiplication (e.g. [3] [I])
;	+03	unbalanced parens
;	+04	invalid operator (e.g. [6] [(])
;
; Operator precedence
;	=
; ??	R( S( U( V( W( [DEF x?]
; ??	, [IN?]
;	(
;	+ -
;	* /
;	^
;
; Register usage:
;	R0	temp, for ALPHA compares
;	R1	temp
;	R2	reserved - PRINT flag/column
;	R3	reserved - (context) variable set/get/iter
;	R4	reserved: max reg used (0 == 25)
;	R5	temp - eval next op precedence
;	R6	temp - eval next op
;	R7	temp - eval RHS/result
;	R8	reserved - stack pointer
;	R9..15	constants (vars) I, J, K, L, X, Y ,Z
;	R16..25	expression stack... TBD (10 levels)
;	R16..[R4]

; Documentation claims that DEF R( 3 , 3 ) consumes only 9
; registers, but the dimensions must be stored someplace
; which would imply 9+1 registers at a minimum.
; Documentation also suggests that one cannot locate the start
; of S( ) without knowing the dimensions of R( ) first, implying
; that these dimensions must be persistent and in a known location.
; It only declares that certain temp registers are used during IN
; and OUT operations, not the entire lifetime of a matrix, so it
; seems these dimensions must be stored in the matrix registers
; (starting after R25 a.k.a. [R4]).
;
; Need to suppport:
;	BEG DEF R( 3 , 3 )	define matrix dimensions
;	BEG DEF R( 3 )		define vector dimensions
;	BEG R( n IN n IN ...	enter elements (no closing paren)
;	BEG R( 1 , 2 ) ...	reference matrix element(s)
;	BEG R( 1 ) ...		reference vectors, too
;	... = R( 3 , 2 )	assign matrix element
;	... = R( 3 )		assign vectors, too
;	BEG R( PAUSE		list/output all elements
;	BEG R( OUT OUT ...	display elements manually
;
; Is R( or S( just a token like [(], with fraction as index?
; 1.0 for [(], 1.1 for [R(], 1.2 for [S(] ?
; DEF sets a flag like BEG/[=] or applied to [R(]?
;
; Matrix is stored in registers as follows, using a base register
; number (R04 + 1):
;
;	      +------------------------+
;	[R04] |  last stack register   |
;	      +------------------------+
;	+1    |  618 buffer register   |
;	      +------------------------+
;	+2    |  R( dimensions reg     | -> MAT len "Nr"
;	      +------------------------+
;	+3    |  R(1,1) register       |
;	      +------------------------+
;	      |        ...             |
;	      +------------------------+
;	+2+Nr |  S( dimensions reg     | -> MAT len "Ns"
;	      +------------------------+
;	+3+Nr |  S(1,1) register       |
;	      +------------------------+
;	      |        ...             |
;	      +------------------------+
;
; Registers used in 618 memory:
;	         +------------------------+
;	0        |  reserved              |
;	         +------------------------+
;	1        |  U( dimensions reg     | -> MAT len "Nu"
;	         +------------------------+
;	2        |  U(1,1) register       |
;	         +------------------------+
;	         |        ...             |
;	         +------------------------+
;	2+Nu     |  V( dimensions reg     | -> MAT len "Nv"
;	         +------------------------+
;	3+Nu     |  V(1,1) register       |
;	         +------------------------+
;	         |        ...             |
;	         +------------------------+
;	3+Nu+Nv  |  W( dimensions reg     | -> MAT len "Nw"
;	         +------------------------+
;	4+Nu+Nv  |  W(1,1) register       |
;	         +------------------------+
;	         |        ...             |
;	         +------------------------+

	.DEF	$begin	@g00	; init all (get var)
	.DEF	$lparen	@g01	; [(]
	.DEF	$rparen	@g02	; [)]
	.DEF	$add	@g03	; [+]
	.DEF	$sub	@g04	; [-]
	.DEF	$mlt	@g05	; [*]
	.DEF	$div	@g06	; [/]
	.DEF	$pwr	@g07	; [^]
	.DEF	$equal	@g08	; [=] (set var)
	.DEF	$var_i	@g09	; set/get/iter vars (get var)
	.DEF	$var_j	@g10	; ...
	.DEF	$var_k	@g11	; ...
	.DEF	$var_l	@g12	; ...
	.DEF	$var_x	@g13	; ...
	.DEF	$var_y	@g14	; ...
	.DEF	$var_z	@g15	; ...
	.DEF	$print	@G00	; BEGIN w/printing
	.DEF	$comma	@G02	; TODO matrix op
	.DEF	$pause	@G04	; TODO matrix op
	.DEF	$in	@G07	; TODO matrix op
	.DEF	$out	@G08	; TODO matrix op
	.DEF	$next	@G09	; iterate var
	.DEF	$def	@G10	; TODO matrix op
	.DEF	$mat_r	@G11	; TODO matrix op
	.DEF	$mat_s	@G12	; TODO matrix op
	.DEF	$mat_u	@G13	; TODO matrix op
	.DEF	$mat_v	@G14	; TODO matrix op
	.DEF	$mat_w	@G15	; TODO matrix op

	; operators as stored on stack
	.EQU	%op_none	0	; prec 0
	.EQU	%op_paren	1	; prec 0
	.EQU	%sop_matr	1.01	; GET op, R3 added
	.EQU	%sop_mats	1.03	; GET op, R3 added
	.EQU	%sop_matu	1.05	; GET op, R3 added
	.EQU	%sop_matv	1.07	; GET op, R3 added
	.EQU	%sop_matw	1.09	; GET op, R3 added
	.EQU	%op_comma	2	; prec 1
	.EQU	%op_add		4	; prec 2
	.EQU	%op_sub		5	; prec 2
	.EQU	%op_mlt		6	; prec 3
	.EQU	%op_div		7	; prec 3
	.EQU	%op_pwr		8	; prec 4
	; how to convert operator to precedence
	.EQU	%op_prec	2	; prec = INT(op / op_prec)

	; states for R3 - context for variables.
	; used directly in INDIR R03 instruction.
	.EQU	%var_ref	1	; reference variable
	.EQU	%var_set	3	; set variable
	.EQU	%var_iter	5	; iterate variable (NEXT)
	.EQU	%mat_def	5	; DEF MAT, overlaps with NEXT

	; register/ID for variables
	.EQU	%varid_i	9
	.EQU	%varid_j	10
	.EQU	%varid_k	11
	.EQU	%varid_l	12
	.EQU	%varid_x	13
	.EQU	%varid_y	14
	.EQU	%varid_z	15

	; constant for calculating step number from register number
	;.EQU	%reg_step	432	// bias to calc step from reg, 600-2
	;.EQU	%reg_step	944	// bias to calc step from reg, 600-6
	.EQU	%reg_step	1968	// bias to calc step from reg, 600-14

MARK $print
	ENTER 1
	ST02	; PRINT (output column number)
	@SEARCH &init

MARK $begin	; the CLEAR key
	T02	; no PRINT
MARK &init
	JIFERR	; turn off prog err, if any
		GO
		GO
	ENTER %var_ref
	ST03	; set flag for variable references
MARK &init0
	RE04	; default to 25
	JIF0
		@SEARCH &init1
	ENTER 25
	ST04
MARK &init1
	ENTER 15	; i.e. -1
	ST08
	CLEAR
	RET

MARK $add	; the [+] key
	ST07
	RE02
	JIFNZ
		@SEARCH &ad0
	; Docs suggest +2 subr levels when printing
	@CALL &print_r7
	ALPHA " +"
	ENTER 2
	+02
MARK &ad0
	ENTER %op_add
	@SEARCH &eval

MARK $sub	; the [-] key
	ST07
	RE02
	JIFNZ
		@SEARCH &su0
	; Docs suggest +2 subr levels when printing
	@CALL &print_r7
	ALPHA " -"
	ENTER 2
	+02
MARK &su0
	ENTER %op_sub
	@SEARCH &eval

MARK $mlt	; the [*] key
	ST07
	RE02
	JIFNZ
		@SEARCH &ml0
	; Docs suggest +2 subr levels when printing
	@CALL &print_r7
	ALPHA " *"
	ENTER 2
	+02
MARK &ml0
	ENTER %op_mlt
	@SEARCH &eval

MARK $div	; the [/] key
	ST07
	RE02
	JIFNZ
		@SEARCH &dv0
	; Docs suggest +2 subr levels when printing
	@CALL &print_r7
	ALPHA " /"
	ENTER 2
	+02
MARK &dv0
	ENTER %op_div
	@SEARCH &eval

MARK $pwr	; the [^] key
	ST07
	RE02
	JIFNZ
		@SEARCH &pw0
	; Docs suggest +2 subr levels when printing
	@CALL &print_r7
	ALPHA " **"
	ENTER 3
	+02
MARK &pw0
	ENTER %op_pwr
	@SEARCH &eval

MARK $lparen	; the [(] key
	; TODO: check for "6 (" case, error +04
	RE02
	JIFNZ
		@SEARCH &lp0
	ALPHA " ("
	ENTER 2
	+02
MARK &lp0
	ENTER %op_paren	; '(' marker
	@SEARCH &push

MARK $rparen	; the [)] key
	ST07
	RE02
	JIFNZ
		@SEARCH &rp0
	; Docs suggest +1 subr levels when printing
	@CALL &print_r7
	ALPHA " )"
	ENTER 2
	+02
MARK &rp0
	ENTER %op_paren	; '(' marker
	@CALL &eval_op
	@CALL &pop	; discard '(' marker
	; TODO: check for R( S( U( V( W(, also DEF prefix.
	; Need to handle assignment, reference, or DEF here.
	; IN/OUT/PAUSE do not use [)] - need error check?
	; PRINT mode only prints results/values, not matrix ops.
	; There appears to be no way to print a matrix (without
	; writing a program to do that).
	JIFNZ
		@SEARCH &err_03	; excess ')'
	; check if MAT op
	ST00
	INT
	-00
	JIF0
		@SEARCH &mat_op
	RET

MARK $equal	; the [=] key
	ST07
	RE02
	JIFNZ
		@SEARCH &eq0
	@CALL &print_r7
	ALPHA " ="
	ENTER 2
	+02
MARK &eq0
	ENTER %var_set
	ST03	; set flag for variable assignments
	ENTER %op_none	; evaluate entire stack. however, unbalanced parens stop early
	@CALL &eval_op
	@CALL &peek
	JIF0
		@SEARCH &err_03	; excess '('
	@CALL &init0
	RE02
	JIFNZ
		@SEARCH &eq1
	@CALL &print_r7
	ALPHA "\r"
	ENTER 1
	ST02
MARK &eq1
	RE07
	RET

; Variable set/get print nothing
MARK $var_i
	ST07
	ENTER %varid_i
	@SEARCH &do_var

MARK $var_j
	ST07
	ENTER %varid_j
	@SEARCH &do_var

MARK $var_k
	ST07
	ENTER %varid_k
	@SEARCH &do_var

MARK $var_l
	ST07
	ENTER %varid_l
	@SEARCH &do_var

MARK $var_x
	ST07
	ENTER %varid_x
	@SEARCH &do_var

MARK $var_y
	ST07
	ENTER %varid_y
	@SEARCH &do_var

MARK $var_z
	ST07
	ENTER %varid_z
MARK &do_var	; R7 is (possible) value to set
	; TODO: check for "3 I" case - error +02
	ST06	; R6 is reg to use
	; This must support:
	;	"BEGIN I + 6 ..." (reference) must work.
	;	"BEGIN 5 = I 7 = J" (assignment) must work.
	;	"BEGIN 5 = I = J" (assignment) must work.
	; basically, pressing I, J, K, ... after [=] resets the flag as for BEGIN.
	; only [=] sets the flag for assignments, reset by var or BEGIN.
	INDIR R03	; 1=get, 3=set, 5=next
	@SEARCH &get_var	; %var_ref
	@SEARCH &set_var	; %var_set
	@SEARCH &do_next	; %var_iter
MARK &get_var
	INDIR RE06
	RET
MARK &set_var
	ENTER %var_ref	; reset, like BEGIN
	ST03
	RE07
	INDIR ST06
	RET
MARK &do_next
	ENTER %var_ref	; reset, like BEGIN
	ST03
	INDIR +06	; 1.MAX -> 2.MAX ...
	ST01
	INT
	ST00		; 1, 2, ... (current count)
	-01		; 0.MAX
	ALPHA SHX+03	; 0.MAX -> MAX.0
	ST01
	ENTER 1
	+01		; MAX+1
	ALPHA JIFR0<	; skip if R0 < MAX+1
		INDIR T06	; 0.0 on terminal count (?)
	INDIR RE06
	INT
	RET

; This can only be used once, and in context of [R(] et al.
MARK $comma
	ST07
	ENTER %op_comma
	@SEARCH &eval

MARK $pause
	; TODO: iterate over elements,
	;  pause 0.5 sec for subscript, 1 sec for element.
	@CALL &ptr_stk
MARK &op0
	RE06	; subscript (had better still be 1.01)
	ALPHA PAUSE
	@CALL &mat_ele	; get element reg in R0/display
	@CALL &ind_re0
	ALPHA PAUSE
	ALPHA PAUSE
	@CALL &mat_next
	JIF0
		@SEARCH &op0
	@CALL &pop	; discard R( etc
	RE06
	RET

MARK $in	; top of stack must be R( etc.
	ST07	; value for element
	; ... get pointer to MAT based on stack op...
	@CALL &ptr_stk
	RE06	; subscript
	@CALL &mat_ele	; get element reg in R0/display
	RE07
	@CALL &ind_st0
	@CALL &mat_next
	JIFNZ
		@CALL &pop	; discard R( etc
	RE06
	RET

MARK $out
	@CALL &ptr_stk
	RE06	; subscript
	@CALL &mat_ele	; get element reg in R0/display
	@CALL &ind_re0
	ST07
	@CALL &mat_next
	JIFNZ
		@CALL &pop	; discard R( etc
	RE07
	RET

MARK $next	; loop interator
	ST07	; TODO: preserve display or not?
	ENTER %var_iter
	ST03	; set flag for variable iterator
	RE07
	RET

MARK $def
	; There is no lhs value. Save/restore anyway.
	ST07
	ENTER %mat_def
	ST03
	RE07
	RET

MARK $mat_r
	ENTER %sop_matr
	@SEARCH &pre_mat

MARK $mat_s
	ENTER %sop_mats
	@SEARCH &pre_mat

MARK $mat_u
	ENTER %sop_matu
	@SEARCH &pre_mat

MARK $mat_v
	ENTER %sop_matv
	@SEARCH &pre_mat

MARK $mat_w
	ENTER %sop_matw
MARK &pre_mat
	ST05	; matrix op
	RE03	; context (get/set/def)
	ALPHA SHX-01
	+05
	INDIR R03
	@SEARCH &pm0
	@SEARCH &pm1
	@SEARCH &pm0
MARK &pm1
	RE07	; must save value to assign
	@CALL &push
MARK &pm0
	ENTER 1.01
	ST06	; initial subscript for IN, OUT, OUT-PAUSE
	RE05	; op code
	@SEARCH &push

; Internal functions

; uses R0
MARK &print_r7
	; if printing beyond column 80,
	; start a new line
	RE02
	ST00
	ENTER 80
	ALPHA JIFR0>=
		@SEARCH &pr0
	ALPHA "\r"
	I/O 12-04	; indent continuation lines
	ENTER 4
	ST02
MARK &pr0
	RE07
	@CALL &printf
	RET

; Uses R0
MARK &precedence
	ST00
	ENTER %op_prec
	/00
	INT
	RET

; Uses: R0
MARK &peek
	; yuk...
	RE08
	ST00
	ENTER 16
	ALPHA JIFR0>=
		@SEARCH &pop0
	INDIR RE08
	RET

; Uses: R0
MARK &pop
	; yuk... also, should re-use peek
	RE08
	ST00
	ENTER 16
	ALPHA JIFR0>=
		@SEARCH &pop0
	INDIR RE08
	ST00
	ENTER 1
	-08
	RE00
	RET
MARK &pop0
	ENTER 0
	RET

; Uses R0, R1
MARK &push
	ST01	; value to push
	RE08	; check overflow, error +01
	ST00
	RE04
	ALPHA JIFR0<
		@SEARCH &err_01
	ENTER 1
	+08
	RE01
	INDIR ST08
	RET

; Entry:
;	display is operator
;	R7 is "rhs"
MARK &eval
	ST06	; op
	@CALL &eval_op
	@CALL &push	; new "lhs" is current "rhs"
	RE06		; op
	@CALL &push	; new op
	RE07
	RET

; while (PREC(peek()) > 0 && PREC(peek()) >= PREC(op)) {
;	lop = pop();
;	lhs = pop();
;	rhs = do_op(lop, lhs, rhs);
; }
; Entry:
;	display is "op"
;	R7 contains "rhs"
; Uses: R0, R1, R5, R7, must preserve R6 for "eval"
; Return:
;	display = R7 = current total ("lhs")
MARK &eval_op
	@CALL &precedence
	ST05	; PREC(op) - target operator precedence
MARK &ev0
	@CALL &peek
	@CALL &precedence
	ST00	; PREC(peek())
	JIFNZ
		@SEARCH &ev1	; TODO: handle this: empty or '('
				; (these don't have a "lhs", must not pop)
	RE05
	ALPHA JIFR0>=	; PREC(peek()) >= PREC(op)
		@SEARCH &ev1
	@CALL &pop	; operator, R8 -> lhs
	ST01		; 2,3,4,5,6
	ENTER 2
	*01		; 4,6,8,10,12
	ENTER 3
	-01		; 1,3,5,7,9
	@CALL &pop	; "lhs" -> R00, display
	EX01		; "lhs" -> R1, display=indir jump
	ST00
	RE07	; "rhs"
	INDIR R00
	@SEARCH &do_comma
	@SEARCH &do_comma	; never reached
	@SEARCH &do_add
	@SEARCH &do_sub
	@SEARCH &do_mlt
	@SEARCH &do_div
	@SEARCH &do_pwr
MARK &do_comma
	ALPHA SHX-02
	+01		; could be DIM or subscript
	@SEARCH &ev2	; caller detects MAT op
MARK &do_add
	+01
	@SEARCH &ev2
MARK &do_sub
	-01
	@SEARCH &ev2
MARK &do_mlt
	*01
	@SEARCH &ev2
MARK &do_div
	/01
	@SEARCH &ev2
MARK &do_pwr
	RE01
	LOGX
	*07
	10^X
MARK &ev2	; display has new "rhs"
	ST07	; set new "rhs"
	@SEARCH &ev0
MARK &ev1	; done
	RE07
	RET

; setup step for temp reg in R1
MARK &temp_step
	RE04
	ST01
	ENTER 1
	+01
	ENTER 8
	*01
	ENTER %reg_step
	EX01
	-01
	RET

; R5 points to base reg of MAT, neg for 618(?)
; R0 is local or remote (R5<0) register number
MARK &ind_re0	; get register in R0, possibly from 618
	RE05
	JIF+
		@SEARCH &rem_re0
	INDIR RE00
	RET
MARK &rem_re0
	ENTER 8
	*00			; R0 = remote memory addr
	@CALL &temp_step	; R1 = step number
	I/O IOR8
	RE04
	ST01
	ENTER 1
	+01
	INDIR RE01
	RET

; R7 is value to store, R0 is register number dest
; R5 points to base reg of MAT, neg for 618(?)
; Uses R0.R1 if remote (618)
MARK &ind_st0	; set register in R0, possibly on 618
	RE05
	JIF+
		@SEARCH &st618
	RE07
	INDIR ST00
	RET
MARK &st618
	RE04
	ST01
	ENTER 1
	+01
	INDIR ST01	; put in buffer/temp
	ENTER 8
	*00
	@CALL &temp_step
	I/O IOW8
	RET

; X is dimension, R5 is DIM register of MAT
; Return: R0/display is register of matrix element
MARK &mat_ele
	ST01
	ENTER 1.01
	-01	; convert to 0-based
	; TODO: validate against DIM
	RE05
	ABS
	ST00
	@CALL &ind_re0
	ST00
	INT
	-00
	ALPHA SHX+02
	JIFNZ
		ENTER 1
		GO
	ST00	; Y dim for scaling
	RE01
	INT
	*00
	RE01
	INT
	-01
	ALPHA SHX+02
	+00
	ENTER 1
	+00
	RE05
	ABS	; correction for 618
	+00
	RET

; Only used during IN, OUT, OUT-PAUSE
; Preserves R7 which is value for OUT, OUT-PAUSE
; Uses R0,R1, updates R6
MARK &mat_next	; advance R6 to next subscript
	RE05	; DIM register
	ABS
	ST00
	@CALL &ind_re0
	ST00
	RE06	; X.YY or 0.000
	JIFNZ
		@SEARCH &mn0	; already past end
	EX00	; X is DIM, R0 is sub
	ALPHA JIFR0<	; safe to increment?
		@SEARCH &mn0
	ST00	; extract DIM Y ...
	INT
	-00
	ENTER .01	; increment Y
	+06		; if no Y overflow, we're done
	ST01	; extract new sub Y
	INT
	-01	; R0 is DIM Y, X/R1 is new sub Y
	ALPHA JIFR0<
		@SEARCH &mn1 ; done
	ENTER 1
	+06
	INT
	ST06
	ENTER .01
	+06
MARK &mn1
	RE06	; 0.0000 after last element
	RET

MARK &mn0
	T06
	RE06
	RET

; Get MAT pointer based on op on stack (must be R(, etc)
MARK &ptr_stk
	; TODO: validate it is a real MAT op
	@CALL &peek
	; TODO: must be 1.1X where X is R( etc.
	JIFNZ
		@SEARCH &err_04
	ALPHA SHX+01
	ST00
	INT
	-00
	ALPHA SHX+01
	ST00
	INDIR R00
	@SEARCH &ptr_r
	@SEARCH &ptr_s
	@SEARCH &ptr_u
	@SEARCH &ptr_v
	@SEARCH &ptr_w

; compute length of MAT in num regs, excl. DIM
; Entry: X is MAT dimensions in X.YY format
; Return R1/display is num registers for elements
MARK &mat_len
	ST00
	INT	; XX
	ST01
	-00	; 0.YY
	ALPHA SHX+02	; YY.0
	JIF0
		*01	; num regs in MAT
		RET
	RE01
	RET

; point to R(
; Return: R5/display is the register number of the R() dimensions
MARK &ptr_r
	RE04
	ST05
	ENTER 2	; skip temp reg, too
	+05
	RET

; point to S(
; Return: R5/display is the register number of the S() dimensions
MARK &ptr_s
	@CALL &ptr_r	; R6 = DIM reg for R(
	INDIR RE05	; get R( dimensions
	@CALL &mat_len	; R5/display = num registers for elements
	+05
	ENTER 1
	+05	; reg no of S( DIM
	RET

; U(, V(, and W( exist only in the 618 memory.
; All accesses must be through this interface.

; point to U(
; Return: R5 is the register number of the U() dimensions
MARK &ptr_u
	ENTER 1-
	ST05
	RET

; point to V(
; Return: R5 is the register number of the V() dimensions
MARK &ptr_v
	@CALL &ptr_u	; R5 = DIM reg for U(
MARK &ptr_rem
	RE05
	ABS
	ST00
	@CALL &rem_re0
	@CALL &mat_len	; R5/display = num registers for elements
	-05
	ENTER 1
	-05	; (-)reg no of V( DIM
	RET

; point to W(
; Return: R5 is the register number of the W() dimensions
MARK &ptr_w
	@CALL &ptr_v	; R5 = DIM reg for V(
	@SEARCH &ptr_rem

; R( S( U( V( W( completed by )
; Entry: display/R0 is 0.mat
;        R7 = matrix DIM or subscript
MARK &mat_op
	ALPHA SHX+01
	ST00
	INT	; 1,3,5 for GET,SET,DEF
	ST03
	-00
	ALPHA SHX+01
	ST00	; 1,3,5,7,9 for R( S( U( V( W(
	INDIR R00
	@SEARCH &do_mat_r
	@SEARCH &do_mat_s
	@SEARCH &do_mat_u
	@SEARCH &do_mat_v
	@SEARCH &do_mat_w

MARK &do_mat_r
	@CALL &ptr_r	; R6 -> R( dim reg
	@SEARCH &mo0
MARK &do_mat_s
	@CALL &ptr_s	; R6 -> S( dim reg
	@SEARCH &mo0
MARK &do_mat_u
	@CALL &ptr_u	; R6 -> U( dim reg on 618 (TBD)
	@SEARCH &mo0
MARK &do_mat_v
	@CALL &ptr_v	; R6 -> V( dim reg on 618 (TBD)
	@SEARCH &mo0
MARK &do_mat_w
	@CALL &ptr_w	; R6 -> W( dim reg on 618 (TBD)
	; @SEARCH &mo0
MARK &mo0	; R5 is matrix DIM reg
	; R5 -> matrix DIM.
	; TODO: validate subscripts against DIM?

	; TODO: subscript to register number in R6, after which
	; same as VAR except no NEXT.
	INDIR R03	; 1=get, 3=set, 5=next (invalid)
	@SEARCH &get_mat
	@SEARCH &set_mat
	; DEFINE MAT dimensions
	; dimensions in R7
	RE05	; MAT DIM reg
	ABS
	ST00
	@SEARCH &ind_st0

MARK &get_mat	; R7 is subscript, R5 is MAT DIM
	RE07
	@CALL &mat_ele	; get element reg in R0/display
	@SEARCH &ind_re0

MARK &set_mat	; R7 is subscript, R5 is MAT DIM
	RE07
	@CALL &mat_ele	; get element reg in R0/display
	@CALL &pop	; value
	ST07
	@SEARCH &ind_st0

MARK &err_01
	ENTER 0
	1/X	; set prog err
	ENTER 01
	STOP	; what happens if user doesn't reset?
	@SEARCH &err_01

MARK &err_02
	ENTER 0
	1/X	; set prog err
	ENTER 02
	STOP	; what happens if user doesn't reset?
	@SEARCH &err_02

MARK &err_03
	ENTER 0
	1/X	; set prog err
	ENTER 03
	STOP	; what happens if user doesn't reset?
	@SEARCH &err_03

MARK &err_04
	ENTER 0
	1/X	; set prog err
	ENTER 04
	STOP	; what happens if user doesn't reset?
	@SEARCH &err_04

	.INCLUDE printf.w6i

	END
