#include "wang600.h"

#include "libplot/plotter.w6h"
#include "libw6/load_tape_data.w6h"

BEGIN()
	CLEAR()
	CALL(load_tape_data)
	J_IF_P() END_PROG()
	ENTER(16)
	ST(startX)
	RE(top_reg)
	ST(maxX)
	ENTER(1)	// scaling in X
	ST(scalX)
	ENTER(30)	// scaling in Y
	ST(scalY)
	ENTER(100)	// translation in X
	ST(tranX)
	ENTER(500)	// translation in Y
	ST(tranY)

	FCALL(plot_data)
	END_PROG()

MARK(DESCRIPTION_FUNCTION)
	ALPHA_PLOT(" OUTDOOR TEMPS TODAY")
	RETURN()
END()
