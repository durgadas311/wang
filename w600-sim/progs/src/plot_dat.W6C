#include "wang600.h"

#include "libplot/plotter.w6h"
#include "libw6/load_tape_data.w6h"

EXTERNAL(setup_point)
FEXTERNAL(plot_moveto)

BEGIN()
	CLEAR()
	CALL(load_tape_data)
	J_IF_P() END_PROG()
	ENTER(16)
	ST(startX)
	RE(top_reg)
	ST(maxX)
	ENTER(5)	// scaling in X
	ST(scalX)
	ENTER(10)	// scaling in Y
	ST(scalY)
	ENTER(10)	// translation in X
	ST(tranX)
	ENTER(200)	// translation in Y
	ST(tranY)

	FCALL(plot_data)

	ENTER(2)
	FCALL(plot_chrsize)
	ENTER(0)
	ST(convX)
	ENTER(-15)
	ST(convY)
	CALL(setup_point)
	FCALL(plot_moveto)
	ALPHA_PLOT("OUTDOOR TEMP, DEG C")
	END_PROG()
END()
