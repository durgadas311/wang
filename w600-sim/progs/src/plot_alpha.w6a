; Wang 612 flatbed plotter demo
;
; Moves the pen to three different locations
; and prints an example of the character set
; at each.

	.OUT	W612
	CLRALL

	; Start at (10,10), character size 1 and spacing 6
	ENTER 10
	ST01
	ST00
	$mov_abs
	ENTER 1
	$chr_size
	ENTER 6
	$chr_space
	$print_chrs	; test print

	; Go to (10,20), character size 2 and spacing 12
	ENTER 10
	ST01
	ENTER 20
	ST00
	$mov_abs
	ENTER 2
	$chr_size
	ENTER 12
	$chr_space
	$print_chrs

	; Go to (10,50), character size 3 and spacing 18
	ENTER 10
	ST01
	ENTER 50
	ST00
	$mov_abs
	ENTER 3
	$chr_size
	ENTER 18
	$chr_space
	$print_chrs

	SEARCH &exit

; move to absolute coords R00,R01
MARK $mov_abs
	ALPHA "\h"
	ALPHA "\m"
	RET

; test print of characters at current location
MARK $print_chrs
	ALPHA "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/+)?=(,:'.*"
	RET

; set character size
MARK $chr_size
	ST01
	T00
	ALPHA "\z"
	RET

; set character spacing
MARK $chr_space
	ST01
	T00
	ALPHA "\s"
	RET

MARK &exit
	END
