#include "wang600.h"

LLABEL(loop)

BEGIN()
	ALPHA_TTY("Converts Fahrenheit to Celcius\r")
MARK(loop)
	ALPHA_TTY("Enter Fahrenheit: ")
	CLR_DISP()
	GROUP1(0xf5)
	ST(15)
	ENTER(32)
	SUB(15)
	ENTER(5)
	MULT(15)
	ENTER(9)
	DIV(15)
	ALPHA_TTY("Celsius = ")
	IO(0x31)
	ALPHA_TTY("\r\r")
	SEARCH(loop)
END()
