#include "wang600.h"

// Labels:
LABEL(loop)
LABEL(end)
FLABEL(f_of_x)
FLABEL(plot)

// Registers:
#define plotX	0
#define plotY	1
#define temp	2
#define lastX	8
#define lastY	9
#define currY	15
#define currX	14
#define maxX	13
#define stepX	12

BEGIN()
	CLEAR()
	ENTER(0)
	ST(currX)
	ENTER(360)
	ST(maxX)
	ENTER(1)
	ST(stepX)
	ALPHA_STRING("\130")
MARK(loop)
	RE(currX)
	FCALL(f_of_x)
	ST(currY)
	FCALL(plot)
	RE(stepX)
	ADD(currX)
	ST(temp)
	RE(maxX)
	SUB(temp)
	J_IF_P() SEARCH(loop)
	END_PROG()

MARK(plot)
	RE(currX)
	ST(plotX)
	RE(lastX)
	SUB(plotX)
	RE(currY)
	ST(plotY)
	RE(lastY)
	SUB(plotY)
	ALPHA_STRING("\131")	// plot "o"
	RE(currX)
	ST(lastX)
	RE(currY)
	ST(lastY)
	RETURN()

MARK(f_of_x)
	SIN()
	ST(temp)
	ENTER(600)
	MULT(temp)
	ENTER(600)
	ADD(temp)
	RETURN()
END()
