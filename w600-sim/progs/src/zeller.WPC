/* ../zeller.wng */

#include "wang600.h"

FLABEL(zeller)
LABEL(pre_march)
LABEL(rejoin)

#define month	0
#define day	1
#define year	2
#define temp	3

BEGIN()
	ST(month)
	PRINT(0,tag_M)
	CLR_DISP()
	STOP()
	ST(day)
	PRINT(0,tag_D)
	CLR_DISP()
	STOP()
	ST(year)
	PRINT(0,tag_Y)
	FCALL(zeller)
	PRINT(0,tag_X)
	PRINT(dp_blank,0)
	END_PROG()

MARK(zeller)
	ENTER(3)
	J_IF_GT()
	SEARCH(pre_march)
MARK(rejoin)
	ENTER(1)
	ADD(month)
	ENTER(26)
	MULT(month)
	ENTER(10)
	DIV(month)
	INT()
	ADD(day)
	ENTER(100)
	DIV(year)
	INT()
	ST(temp)
	SUB(year)
	ENTER(100)
	MULT(year)
	ADD(day)
	ENTER(4)
	DIV(year)
	INT()
	ADD(day)
	RE(temp)
	ST(year)
	ENTER(5)
	MULT(year)
	ADD(day)
	ENTER(4)
	DIV(temp)
	INT()
	ADD(day)
	ENTER(7)
	DIV(day)
	INT()
	SUB(day)
	ENTER(7)
	MULT(day)
	DP()
	ENTER(5)
	ADD(day)
	INT()
	RETURN()
MARK(pre_march)
	ENTER(12)
	ADD(month)
	ENTER(1)
	SUB(year)
	SEARCH(rejoin)
END()
