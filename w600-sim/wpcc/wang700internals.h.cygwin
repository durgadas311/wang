/*
 * Internals of warping Wang 700 programs through GCC
 *
 *
 */

#ifndef __wpcc_wang700internals_h__
#define __wpcc_wang700internals_h__

.ident "Wang 700 Compiler over GCC $Revision: 1.1 $ "

.section .wang700code, "a"
	.include "wang700opcodes.s"
.section .wang700regs,"a"
.section .wang700regs,0	// initialized registers go here
		.align 2
		longreg_base:
.section .wang700regs,1	// uninitialized registers go here
		.align 2
		.byte 0, 0		// skip over postamble...
.section .wang700data,"a"
	.align 16
.section .wang700code, "a"

#define _shadow_code(n)	 \
			.section .wang700dummy,"a"; \
				.rept n; .byte 0; .endr; \
			.section .wang700code, "a"

#define _bytecode(__byte)	.byte (__byte); _shadow_code(1)

#define _opcode(op)		.byte (_op_ ##op ); _shadow_code(1)

#define _opsearch(label)	_opcode(SEARCH); _bytecode(label); _shadow_code(2)

// Uninitialized registers are "allocated" here.
#define _longreg(reg)		.section .wang700regs,1,"a"; \
					.global _longreg_ ##reg ;	\
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.)-1; \
					.byte 0;	\
				.section .wang700code, "a"

#define _longregs(reg,numregs)	.section .wang700regs,1,"a"; \
					.global _longreg_ ##reg ;	\
					.rept (numregs-1);		\
					.byte 0;	\
					.endr;	\
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.)-1; \
					.byte 0;	\
				.section .wang700code, "a"

// Initialized registers are "allocated" here. This data must be post-processed
// into viable register images, as the Wang 700 interleaves pairs of registers.
#define _regdata(reg,b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15)	\
				.section .wang700regs,0; \
					.global _longreg_ ##reg ; \
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.)-1; \
					.byte 0;	\
				.section .wang700data,"a"; \
					.byte (( b15 ) << 4) | ( b14 );	\
					.byte (( b13 ) << 4) | ( b12 );	\
					.byte (( b11 ) << 4) | ( b10 );	\
					.byte (( b9 ) << 4) | ( b8 );	\
					.byte (( b7 ) << 4) | ( b6 );	\
					.byte (( b5 ) << 4) | ( b4 );	\
					.byte (( b3 ) << 4) | ( b2 );	\
					.byte (( b1 ) << 4) | ( b0 );	\
				.section .wang700code, "a"

#define _llongreg(reg)		.section .wang700regs,1,"a"; \
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.)-1; \
					.byte 0;	\
				.section .wang700code, "a"

#define _llongregs(reg,numregs)	.section .wang700regs,1,"a"; \
					.rept (numregs-1);		\
					.byte 0;	\
					.endr;	\
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.)-1; \
					.byte 0;	\
				.section .wang700code, "a"

// Initialized registers are "allocated" here. This data must be post-processed
// into viable register images, as the Wang 700 interleaves pairs of registers.
#define _lregdata(reg,b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15)	\
				.section .wang700regs,0; \
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.)-1; \
					.byte 0;	\
				.section .wang700data,"a"; \
					.byte (( b15 ) << 4) | ( b14 );	\
					.byte (( b13 ) << 4) | ( b12 );	\
					.byte (( b11 ) << 4) | ( b10 );	\
					.byte (( b9 ) << 4) | ( b8 );	\
					.byte (( b7 ) << 4) | ( b6 );	\
					.byte (( b5 ) << 4) | ( b4 );	\
					.byte (( b3 ) << 4) | ( b2 );	\
					.byte (( b1 ) << 4) | ( b0 );	\
				.section .wang700code, "a"

#define _oplongreg(op,reg)	_bytecode(0xe0 | (_op_ ##op & 0x0f)); \
				_bytecode(_longreg_ ##reg)

/***************************************************************************/

#define BEGIN()
#define END()

#define RES_EXTERN(label, const)	.error "RES_EXTERN() is deprecated"
#define RES_FEXTERN(label, const)	.error "RES_FEXTERN() is deprecated"

// need way to error-check, both here and link time.
#define HW_FIXED_SR0(label) 	\
				.section .wang700flabel.__hardcode_sr0,"a"; \
					.global label ; \
					label : .byte 0;\
				.section .wang700subr.__hardcode_sr0,"a"; \
					.global _subr_ ##label ; \
					_subr_ ##label : .byte 0;\
				.section .wang700code, "a"

// Define a label for use with SEARCH/MARK
#define LABEL(label)		.section .wang700label,"a"; \
					.global label ; \
					label :  .byte 0; \
				.section .wang700code, "a"

// Define a label for use with SEARCH/MARK
#define LLABEL(label)		.section .wang700label,"a"; \
					label :  .byte 0; \
				.section .wang700code, "a"

// Define a label for use with FCALL/MARK
#define FLABEL(label)		.section .wang700flabel. ##label,"a"; \
					.global label ; \
					label :  .byte 0; \
				.section .wang700subr. ##label,"a"; \
					.global _subr_ ##label ; \
					_subr_ ##label :  .byte 0; \
				.section .wang700code, "a"

// Define a label for use with FCALL/MARK
#define FLLABEL(label)		.section .wang700flabel,"a"; \
					label :  .byte 0; \
				.section .wang700subr,"a"; \
					_subr_ ##label :  .byte 0; \
				.section .wang700code, "a"

// A label from another module for use with SEARCH/CALL
#define EXTERNAL(label)		.section .wang700label,"a"; \
					.global label ; \
				.section .wang700code, "a"

// A label from another module for use with FCALL
#define FEXTERNAL(label)	.section .wang700flabel,"a"; \
					.global label ; \
				.section .wang700subr,"a"; \
					.global _subr_ ##label ; \
				.section .wang700code, "a"

#define FORDERED(label, tag)	FEXTERNAL(label); \
				.print #label; .print #tag

#define REG_EXTERNAL(reg)	\
				.section .wang700regs,"a"; \
					.global _longreg_ ##reg ; \
				.section .wang700code, "a"

// Does not prevent conflicts. Programmer must ensure "reg" has no
// conflicting uses (including program code) in the same program.
// Does not allocarte any space, simply sets up reference to the register
// number by the given label.
#define RES_REG(reg,regnum)	\
					.global _longreg_ ##reg ; \
					.set _longreg_ ##reg , regnum

// Reserve an un-initialize long register. This prevents conflicts
// between all UREG() definitions, and will not overwrite program code.
// However, RES_REG() can still conflict. This actually allocates "empty" space
// for the register data.
#define UREG(name)		_longreg(name)
#define LUREG(name)		_llongreg(name)

#define UREGS(name, num)	_longregs(name,num)
#define LUREGS(name, num)	_llongregs(name,num)

/* These should be pre-rpocessed and never exist when gcc invoked */
#define ENTER(num)		.error "run wpcpp preprocessor for ENTER()"
#define IREG_DATA(reg,val)	.error "run wpcpp preprocessor for IREG_DATA()"
#define LIREG_DATA(reg,val)	.error "run wpcpp preprocessor for LIREG_DATA()"
#define ALPHA_STRING(str)	.error "run wpcpp preprocessor for ALPHA_STRING()"
#define ALPHA_PLOT(str)		.error "run wpcpp preprocessor for ALPHA_PLOT()"
#define ALPHA_TTY(str)		.error "run wpcpp preprocessor for ALPHA_TTY()"

// Enter into X the register number associated with the symbol <label>
#define ENTER_REGNO(name)	_bytecode(0xed); \
				_bytecode(0xed); \
				_bytecode(_longreg_ ##name )

// Enter into X the highest register number not occupied by program code
#define ENTER_LAST_REGNO()	_bytecode(0xed); \
				_bytecode(0xed); \
				_bytecode(__last_reg)

// Pseudo constructs for embedding data (future plan)
#define NAME(prog_name)		.section .wang700name,"a",@note; \
					.string " prog_name "; \
				.section .wang700code, "a"

#define AUTHOR(name)		.section .wang700author,"a",@note; \
					.string " name "; \
				.section .wang700code, "a"

#define TITLE(title)		.section .wang700title,"a",@note; \
					.string " title "; \
				.section .wang700code, "a"

#define HELP_BEGIN(string)	.section .wang700help,"a",@note; \
					.string " string ";\
				.section .wang700code, "a"

#endif /* __wpcc_wang700internals_h__ */
