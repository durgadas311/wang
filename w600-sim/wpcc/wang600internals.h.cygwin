/*
 * Internals of warping Wang 600 programs through GCC
 *
 *
 */

#ifndef __wpcc_wang600internals_h__
#define __wpcc_wang600internals_h__

.ident "Wang 600 Compiler over GCC $Revision: 1.1 $ "

.section .wang600code, "a";
	.include "wang600opcodes.s";
.section .wang600regs,"a";
.section .wang600regs,0;
	longreg_base:;
.section .wang600regs,1;
	.byte 0;
.section .wang600code, "a";

#define _shadow_code(n)	 \
			.section .wang600dummy,"a"; \
				.rept n; .byte 0; .endr; \
			.section .wang600code, "a";

#define _bytecode(__byte)	.byte (__byte); _shadow_code(1)

#define _opcode(op)		.byte (_op_ ##op ); _shadow_code(1)
#define _opreg(op,regnum)	.byte (_op_ ##op ##regnum ); _shadow_code(1)

#define _oplabel(prefix,label)	.byte ( ##prefix ##label ),( ##label ); \
					_shadow_code(2)

#define _longreg(reg)		.section .wang600regs,1,"a"; \
					.global _longreg_ ##reg ;	\
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.); \
					.byte 0;	\
				.section .wang600code, "a"

#define _longregs(reg,numregs)	.section .wang600regs,1,"a"; \
					.global _longreg_ ##reg ;	\
					.rept (numregs-1);			\
					.byte 0;			\
					.endr;				\
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.); \
					.byte 0;	\
				.section .wang600code, "a"

#define _regdata(reg,b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15)	\
				.section .wang600regs,0; \
					.global _longreg_ ##reg ; \
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.); \
					.byte 0;	\
				.section .wang600data,"a"; \
					.align 8;		\
					.byte ((b15) << 4) | (b14);	\
					.byte ((b13) << 4) | (b12);	\
					.byte ((b11) << 4) | (b10);	\
					.byte ((b9) << 4) | (b8);	\
					.byte ((b7) << 4) | (b6);	\
					.byte ((b5) << 4) | (b4);	\
					.byte ((b3) << 4) | (b2);	\
					.byte ((b1) << 4) | (b0);	\
				.section .wang600code, "a"

#define _llongreg(reg)		.section .wang600regs,1,"a"; \
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.); \
					.byte 0;	\
				.section .wang600code, "a"

#define _llongregs(reg,numregs)	.section .wang600regs,1,"a"; \
					.rept (numregs-1);			\
					.byte 0;			\
					.endr;				\
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.); \
					.byte 0;	\
				.section .wang600code, "a"

#define _lregdata(reg,b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15)	\
				.section .wang600regs,0; \
					.set _longreg_ ##reg ,longreg_base+(longreg_base-.); \
					.byte 0;	\
				.section .wang600data,"a"; \
					.align 8;		\
					.byte ((b15) << 4) | (b14);	\
					.byte ((b13) << 4) | (b12);	\
					.byte ((b11) << 4) | (b10);	\
					.byte ((b9) << 4) | (b8);	\
					.byte ((b7) << 4) | (b6);	\
					.byte ((b5) << 4) | (b4);	\
					.byte ((b3) << 4) | (b2);	\
					.byte ((b1) << 4) | (b0);	\
				.section .wang600code, "a"

#define _oplongreg(op,reg)	_opcode(op); _bytecode(_longreg_ ##reg)

/***************************************************************************/

#define BEGIN()
#define END()

#define RES_EXTERN(label, const)	.error "RES_EXTERN() is deprecated"
#define RES_FEXTERN(label, const)	.error "RES_FEXTERN() is deprecated"

// need way to error-check, both here and link time.
#define HW_FIXED_F0(flabel)	\
				.section .wang600flabel.__hardcode_f0,"a"; \
					.global flabel ; \
					flabel : .byte 0; \
				.section .wang600search,"a"; \
					.global _search_ ##flabel ; \
					.set _search_ ##flabel , 0x80; \
				.section .wang600call,"a"; \
					.global _call_ ##flabel ; \
					.set _call_ ##flabel , 0xf7; \
				.section .wang600subr.__hardcode_f0,"a"; \
					.global _subr_ ##flabel ; \
					_subr_ ##flabel :  .byte 0; \
				.section .wang600code, "a"

// Define a label for use with SEARCH/MARK
#define LABEL(label)		.section .wang600label,"a"; \
					.global label; \
					label : .byte 0; \
				.section .wang600search,"a"; \
					.global _search_ ##label ; \
					_search_ ##label :; \
				.section .wang600call,"a"; \
					.global _call_ ##label ; \
					_call_ ##label :; \
				.section .wang600code, "a"

// Define a label for use with SEARCH/MARK
#define LLABEL(label)		.section .wang600label,"a"; \
					label : .byte 0; \
				.section .wang600search,"a"; \
					_search_ ##label :; \
				.section .wang600call,"a"; \
					_call_ ##label :; \
				.section .wang600code, "a"

// Define a label for use with FCALL/MARK
#define FLABEL(label)		.section .wang600flabel. ##label,"a"; \
					.global label ; \
					label :  .byte 0; \
				.section .wang600search,"a"; \
					.global _search_ ##label ; \
					_search_ ##label :; \
				.section .wang600call,"a"; \
					.global _call_ ##label ; \
					_call_ ##label :; \
				.section .wang600subr. ##label,"a"; \
					.global _subr_ ##label ; \
					_subr_ ##label :  .byte 0; \
				.section .wang600code, "a"

// Define a label for use with FCALL/MARK
#define FLLABEL(label)		.section .wang600flabel,"a"; \
					label :  .byte 0; \
				.section .wang600search,"a"; \
					_search_ ##label :; \
				.section .wang600call,"a"; \
					_call_ ##label :; \
				.section .wang600subr,"a"; \
					_subr_ ##label :  .byte 0; \
				.section .wang600code, "a"

// A label from another module for use with SEARCH/CALL
#define EXTERNAL(label)		.section .wang600label,"a"; \
					.global label ; \
				.section .wang600search,"a"; \
					.global _search_ ##label ; \
				.section .wang600call,"a"; \
					.global _call_ ##label ; \
				.section .wang600code, "a"

// A label from another module for use with FCALL
#define FEXTERNAL(label)	.section .wang600flabel,"a"; \
					.global label ; \
				.section .wang600search,"a"; \
					.global _search_ ##label ; \
				.section .wang600call,"a"; \
					.global _call_ ##label ; \
				.section .wang600subr,"a"; \
					.global _subr_ ##label ; \
				.section .wang600code, "a"

#define FORDERED(label, tag)	FEXTERNAL(label); \
				.print #label; .print #tag

#define ROM_EXTERNAL(label)	\
				.section .wang600label. ##label,"a"; \
					.global label ; \
					label : .byte 0; \
				.section .wang600search,"a"; \
					.global _search_ ##label ; \
					.set _search_ ##label , 0x80; \
				.section .wang600call,"a"; \
					.global _call_ ##label ; \
					.set _call_ ##label , 0xf7; \
				.section .wang600code, "a"

#define ROM_FEXTERNAL(flabel)	\
				.section .wang600flabel. ##flabel,"a"; \
					.global flabel ; \
					flabel : .byte 0; \
				.section .wang600search,"a"; \
					.global _search_ ##flabel ; \
					.set _search_ ##flabel , 0x80; \
				.section .wang600call,"a"; \
					.global _call_ ##flabel ; \
					.set _call_ ##flabel , 0xf7; \
				.section .wang600subr. ##flabel,"a"; \
					.global _subr_ ##flabel ; \
					_subr_ ##flabel :  .byte 0; \
				.section .wang600code, "a"

#define REG_EXTERNAL(reg)	\
				.section .wang600regs,"a"; \
					.global _longreg_ ##reg ; \
				.section .wang600code, "a"

#define RES_REG(reg,regnum)	\
					.global _longreg_ ##reg; \
					.set _longreg_ ##reg , regnum

// Reserve an un-initialize long register
#define UREG(name)		_longreg(name)
#define LUREG(name)		_llongreg(name)

// Reserve an array of "num" longregs
#define UREGS(name,num)		_longregs(name,num)
#define LUREGS(name,num)	_llongregs(name,num)

/* These should be pre-rpocessed and never exist when gcc invoked */
#define ENTER(num)		.error "run wpcpp preprocessor for ENTER()"
#define IREG_DATA(reg,val)	.error "run wpcpp preprocessor for IREG_DATA()"
#define LIREG_DATA(reg,val)	.error "run wpcpp preprocessor for LIREG_DATA()"
#define ALPHA_STRING(str)	.error "run wpcpp preprocessor for ALPHA_STRING()"
#define ALPHA_PLOT(str)		.error "run wpcpp preprocessor for ALPHA_PLOT()"
#define ALPHA_TTY(str)		.error "run wpcpp preprocessor for ALPHA_TTY()"

// This forces us to post-process Wang600 programs now...
#define ENTER_REGNO(name)	_bytecode(0xf8); \
				_bytecode(0xf8); \
				_bytecode(_longreg_ ##name )

// since we have to post-process, might as well simplify this too
#define ENTER_LAST_REGNO()	_bytecode(0xf8); \
				_bytecode(0xf8); \
				_bytecode(__last_reg)

// Pseudo constructs for embedding data (future plan)
#define NAME(prog_name)		.section .wang600name,"a",@note; \
					.string " prog_name "; \
				.section .wang600code, "a"

#define AUTHOR(name)		.section .wang600author,"a",@note; \
					.string " name "; \
				.section .wang600code, "a"

#define TITLE(title)		.section .wang600title,"a",@note; \
					.string " title "; \
				.section .wang600code, "a"

#define HELP_BEGIN(string)	.section .wang600help,"a",@note; \
					.string " string ";"\
				.section .wang600code, "a"

#endif /* __wpcc_wang600internals_h__ */
