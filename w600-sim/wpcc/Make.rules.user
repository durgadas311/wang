# $Id: Make.rules.user,v 1.14 2014/01/10 23:01:23 drmiller Exp $

WPCC ?= /usr/local/wpcc

WPCCINC = $(WPCC)/include
WPCCLIB = $(WPCC)/lib
WPCCBIN = $(WPCC)/bin

W6TLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(T6_LDSCRIPT) $(W6LDADD)
W6TLIBS =
W6TLDEPS =
W7TLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(T7_LDSCRIPT) $(W7LDADD)
W7TLIBS =
W7TLDEPS =
W6XLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(X_LDSCRIPT) -Wl,-q
W6XLIBS =
W6CCFLAGS = -nostartfiles -nodefaultlibs -nostdlib -Wa,-I$(WPCCINC) -I$(WPCCINC)
W7CCFLAGS = -nostartfiles -nodefaultlibs -nostdlib -Wa,-I$(WPCCINC) -I$(WPCCINC)
W6OLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(O6_LDSCRIPT) -Wl,-q $(W6LDADD)
W7OLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(O7_LDSCRIPT) -Wl,-q $(W7LDADD)

T7_LDSCRIPT = wang700raw.ld
T6_LDSCRIPT = wang600raw.ld
X_LDSCRIPT = wang600rawrom.ld
O7_LDSCRIPT = wang700elf.ld
O6_LDSCRIPT = wang600elf.ld

OBJCOPY = objcopy
READELF = readelf
AWK = awk
CPP = false	# prevent accidental (mis-)use
W6CPP = $(WPCCBIN)/w6cpp
W6LDFIX = $(WPCCBIN)/w6ldfix
W7CPP = $(WPCCBIN)/w7cpp
W7LDFIX = $(WPCCBIN)/w7ldfix

%.w6t: %.w6c $(W6TLDEPS)
	$(W6CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp $(W6TLDFLAGS) $(W6CCFLAGS) \
		-o $*.w6$$ $*.wpe $(W6TLIBS)
	@rm -f $*.wpe
	$(W6LDFIX) $*.w6$$
	@rm -f $*.w6$$

%.w6o: %.w6c
	$(W6CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp -c $(W6CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

%.w7t: %.w7c $(W7TLDEPS)
	$(W7CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp $(W7TLDFLAGS) $(W7CCFLAGS) \
		-o $*.w7$$ $*.wpe $(W7TLIBS)
	@rm -f $*.wpe
	$(W7LDFIX) $*.w7$$
	@rm -f $*.w7$$

%.w7o: %.w7c
	$(W7CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp -c $(W7CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

# experimental
%.wfl: %.w7c $(W7TLDEPS)
	$(W7CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp $(W7OLDFLAGS) $(W7CCFLAGS) \
		-o $*.w7r $*.wpe $(W7TLIBS)
	@rm -f $*.wpe
	$(WPCCBIN)/symbols2labels .wang700flabels $*.w7r >$@
	$(OBJCOPY) -j .wang700prog -O binary $*.w7r $*.w7$$
	$(W7LDFIX) $*.w7$$
	@rm -f $*.w7$$
	@rm -f $*.w7r

####################################
############ DEPRECATED ############

%.w6t: %.W6C $(W6TLDEPS)
	$(W6CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp $(W6TLDFLAGS) $(W6CCFLAGS) \
		-o $*.w6$$ $*.wpe $(W6TLIBS)
	@rm -f $*.wpe
	$(W6LDFIX) $*.w6$$
	@rm -f $*.w6$$

%.w6o: %.W6C
	$(W6CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp -c $(W6CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

%.w7t: %.W7C $(W7TLDEPS)
	$(W7CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp $(W7TLDFLAGS) $(W7CCFLAGS) \
		-o $*.w7$$ $*.wpe $(W7TLIBS)
	@rm -f $*.wpe
	$(W7LDFIX) $*.w7$$
	@rm -f $*.w7$$

%.w7o: %.W7C
	$(W7CPP) $< > $*.wpe
	$(CC) -x assembler-with-cpp -c $(W7CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

######################################
# For making XROM images... 600 only.
.PRECIOUS: %.w6r

%.w6s: %.w6r
	@echo "Post-processing $< into $@..."
	@$(READELF) -s $< | \
		$(AWK) '/<corrupt>/{next;}$$5=="GLOBAL"{print ".globl " $$NF "; .set " $$NF ",0x" $$2; }' | \
		$(AS) -o $@

%.w6x: %.w6r
	$(OBJCOPY) -j .wang600rom -O binary $< $@

%.wfl: %.w6r
	$(WPCCBIN)/symbols2labels .wang600flabels $< >$@

###%.w6r: %/%.a
# for some reason --whole-archive doesn't work - perhaps 'ld' only looks for *.o
%.w6r: %/*.w6o
	$(CC) $(W6CCFLAGS) $(W6XLDFLAGS) \
		-o $@ $^
