# $Id: Make.rules.user,v 1.10 2013/12/24 14:28:59 drmiller Exp $

WPCC ?= /usr/local/wpcc

WPCCINC = $(WPCC)/include
WPCCLIB = $(WPCC)/lib
WPCCBIN = $(WPCC)/bin

W6TLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(T6_LDSCRIPT)
W6TLIBS =
W6TLDEPS =
W7TLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(T7_LDSCRIPT)
W7TLIBS =
W7TLDEPS =
W6XLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(X_LDSCRIPT) -Wl,-q
W6XLIBS =
W6CCFLAGS = -nostartfiles -nodefaultlibs -nostdlib -Wa,-I$(WPCCINC) -I$(WPCCINC)
W7CCFLAGS = -nostartfiles -nodefaultlibs -nostdlib -Wa,-I$(WPCCINC) -I$(WPCCINC)

T7_LDSCRIPT = wang700raw.ld
T6_LDSCRIPT = wang600raw.ld
X_LDSCRIPT = wang600rawrom.ld

OBJCOPY = objcopy
READELF = readelf
AWK = awk
CPP = false	# prevent accidental (mis-)use
W6CPP = $(WPCCBIN)/w6cpp
W7CPP = $(WPCCBIN)/w7cpp
W7LDFIX = $(WPCCBIN)/w7ldfix

%.w6t: %.w6c $(W6TLDEPS)
	$(CC) -x c $(W6TLDFLAGS) $(W6CCFLAGS) \
		-o $@ $< $(W6TLIBS)

%.w6t: %.W6C $(W6TLDEPS)
	$(W6CPP) $< > $*.wpe
	$(CC) -x c $(W6TLDFLAGS) $(W6CCFLAGS) \
		-o $@ $*.wpe $(W6TLIBS)
	@rm -f $*.wpe

%.w6o: %.w6c
	$(CC) -x c -c $(W6CCFLAGS) -o $@ $<

%.w6o: %.W6C
	$(W6CPP) $< > $*.wpe
	$(CC) -x c -c $(W6CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

%.w7t: %.w7c $(W7TLDEPS)
	$(CC) -x c $(W7TLDFLAGS) $(W7CCFLAGS) \
		-o $*.w7$$ $< $(W7TLIBS)
	$(W7LDFIX) $*.w7$$
	@rm -f $*.w7$$

%.w7t: %.W7C $(W7TLDEPS)
	$(W7CPP) $< > $*.wpe
	$(CC) -x c $(W7TLDFLAGS) $(W7CCFLAGS) \
		-o $*.w7$$ $*.wpe $(W7TLIBS)
	@rm -f $*.wpe
	$(W7LDFIX) $*.w7$$
	@rm -f $*.w7$$

%.w7o: %.w7c
	$(CC) -x c -c $(W7CCFLAGS) -o $@ $<

%.w7o: %.W7C
	$(W7CPP) $< > $*.wpe
	$(CC) -x c -c $(W7CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

#################################
# For making XROM images... 600 only.
.PRECIOUS: %.w6r

%.w6s: %.w6r
	@echo "Post-processing $< into $@..."
	@$(READELF) -s $< | \
		$(AWK) '/<corrupt>/{next;}$$5=="GLOBAL"{print ".globl " $$NF "; .set " $$NF ",0x" $$2; }' | \
		$(AS) -o $@

%.w6x: %.w6r
	$(OBJCOPY) -j .wang600rom -O binary $< $@

###%.w6r: %/%.a
# for some reason --whole-archive doesn't work - perhaps 'ld' only looks for *.o
%.w6r: %/*.w6o
	$(CC) $(W6CCFLAGS) $(W6XLDFLAGS) \
		-o $@ $^
