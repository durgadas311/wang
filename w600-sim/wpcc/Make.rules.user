# $Id: Make.rules.user,v 1.6 2013/02/04 23:04:29 drmiller Exp $

WPCC ?= /usr/local/wpcc

WPCCINC = $(WPCC)/include
WPCCLIB = $(WPCC)/lib
WPCCBIN = $(WPCC)/bin

W6TLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(T_LDSCRIPT)
W6TLIBS =
W6XLDFLAGS = -L$(WPCCLIB) -Wl,-T,$(X_LDSCRIPT) -Wl,-q
W6XLIBS =
W6CCFLAGS = -nostartfiles -nodefaultlibs -nostdlib -Wa,-I$(WPCCINC) -I$(WPCCINC)

T_LDSCRIPT = wang600raw.ld
X_LDSCRIPT = wang600rawrom.ld

OBJCOPY = objcopy
READELF = readelf
AWK = awk
CPP = $(WPCCBIN)/w6cpp

%.w6t: %.w6c
	$(CC) -x c $(W6TLDFLAGS) $(W6CCFLAGS) \
		-o $@ $< $(W6TLIBS)

%.w6t: %.W6C
	$(CPP) $< > $*.wpe
	$(CC) -x c $(W6TLDFLAGS) $(W6CCFLAGS) \
		-o $@ $*.wpe $(W6TLIBS)
	@rm -f $*.wpe

%.w6o: %.w6c
	$(CC) -x c -c $(W6CCFLAGS) -o $@ $<

%.w6o: %.W6C
	$(CPP) $< > $*.wpe
	$(CC) -x c -c $(W6CCFLAGS) -o $@ $*.wpe
	@rm -f $*.wpe

#################################
# For making XROM images...
.PRECIOUS: %.w6r

%.w6s: %.w6r
	@echo "Post-processing $< into $@..."
	@$(READELF) -s $< | \
		$(AWK) '$$5=="GLOBAL"{print ".globl " $$NF "; .set " $$NF ",0x" $$2; }' | \
		$(AS) -o $@

%.w6x: %.w6r
	$(OBJCOPY) -j .wang600rom -O binary $< $@

###%.w6r: %/%.a
# for some reason --whole-archive doesn't work - perhaps 'ld' only looks for *.o
%.w6r: %/*.w6o
	$(CC) $(W6CCFLAGS) $(W6XLDFLAGS) \
		-o $@ $^
