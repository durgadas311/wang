# $Id: Make.rules.user,v 1.5 2013/02/04 22:11:26 drmiller Exp $

WPCC ?= /usr/local/wpcc

WPCCINC = $(WPCC)/include
WPCCLIB = $(WPCC)/lib
WPCCBIN = $(WPCC)/bin

T_LDSCRIPT = wang600raw.ld
X_LDSCRIPT = wang600rawrom.ld

OBJCOPY = objcopy
READELF = readelf
AWK = awk
CPP = $(WPCCBIN)/w6cpp

%.w6t: %.w6c
	$(CC) -x c -nostartfiles -nodefaultlibs -nostdlib -Wl,-T,$(T_LDSCRIPT) \
		-Wa,-I$(WPCCINC) \
		-I$(WPCCINC) -L$(WPCCLIB) \
		-o $@ $<

%.w6t: %.W6C
	$(CPP) $< > $*.wpe
	$(CC) -x c -nostartfiles -nodefaultlibs -nostdlib -Wl,-T,$(T_LDSCRIPT) \
		-Wa,-I$(WPCCINC) \
		-I$(WPCCINC) -L$(WPCCLIB) \
		-o $@ $*.wpe
	@rm -f $*.wpe

%.w6o: %.w6c
	$(CC) -x c -c -Wa,-I$(WPCCINC) -I$(WPCCINC) -o $@ $<

%.w6o: %.W6C
	$(CPP) $< > $*.wpe
	$(CC) -x c -c -Wa,-I$(WPCCINC) -I$(WPCCINC) -o $@ $*.wpe
	@rm -f $*.wpe

#################################
# For making XROM images...
.PRECIOUS: %.w6r

%.w6s: %.w6r
	@echo "Post-processing $< into $@..."
	@$(READELF) -s $< | \
		$(AWK) '$$5=="GLOBAL"{print ".globl " $$NF "; .set " $$NF ",0x" $$2; }' | \
		$(AS) -o $@

%.w6x: %.w6r
	$(OBJCOPY) -j .wang600rom -O binary $< $@

###%.w6r: %/%.a
# for some reason --whole-archive doesn't work - perhaps 'ld' only looks for *.o
%.w6r: %/*.w6o
	$(CC) -nostartfiles -nodefaultlibs -nostdlib -Wl,-T,$(X_LDSCRIPT) \
		-L$(WPCCLIB) -Wl,-q \
		-o $@ $^
