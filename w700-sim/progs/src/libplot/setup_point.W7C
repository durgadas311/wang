#include "wang700.h"

#include "plotter.w7h"

// Labels:
FLABEL(setup_point)

BEGIN()
MARK(setup_point)
	// input point is (convX,convY), output is (plotX,plotY)
	// scale/translate point and compute relative change from last point
	RE_Y_DIR(convX)
	RE_DIR(scaleX)
	MULT_Y()
	ENTER(0.5)
	ADD_Y()
	RE_Y()
	INT()
	ST_DIR(convX)
	ST_Y()
	RE_DIR(tranX)
	ADD_Y()		// Y is new point, absolute
	RE_DIR(lastX)
	ST_Y_DIR(lastX)
	SUB_Y()		// Y is new point, relative
	ST_Y_DIR(plotX)

	RE_Y_DIR(convY)
	RE_DIR(scaleY)
	MULT_Y()
	ENTER(0.5)
	ADD_Y()
	RE_Y()
	INT()
	ST_DIR(convY)
	ST_Y()
	RE_DIR(tranY)
	ADD_Y()		// Y is new point, absolute
	RE_DIR(lastY)
	ST_Y_DIR(lastY)
	SUB_Y()		// Y is new point, relative
	ST_Y_DIR(plotY)

	RETURN()
END()
