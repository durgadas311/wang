#include "wang700.h"

#include "plotter.w7h"	// get out interface to the world

FLABEL(plot_data)
FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
FEXTERNAL(setup_point)
FEXTERNAL(plot_home)

// Labels:
LLABEL(loop1)
LLABEL(loop2)
LLABEL(loop3)
LLABEL(done)

RES_FEXTERN(PAPERTAPE_END, 0)	// dictated by peripheral hardware...

BEGIN()
MARK(plot_data)
	// do first point as "move", not "plot"
	ENTER(0)
	ST_DIR(lastX)
	ST_DIR(lastY)
	FCALL(plot_home)
	RE_DIR(startX)
	ST_DIR(currX)
	ENTER(0)
	ST_DIR(convX)
	GROUP1(0x00)	// read a number from paper tape
	SK_IF_ERR() SEARCH(loop1)
MARK(done)
	RE_DIR(currX)
	ST_DIR(maxX)
	RETURN()

MARK(loop1)
	ST_DIR(convY)
	ST_DIR(maxY)	// first point is both min and max...
	ST_DIR(minY)
	FCALL(setup_point) // last should be (0,0)
	FCALL(plot_moveto)
	ENTER(1)
	ADD_DIR(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop3)
	RE_DIR(currX)
	ST_DIR(convX)
	RE_DIR(startX)
	SUB_DIR(convX) // data idx "0", not actual register number
	GROUP1(0x00)	// read a number from paper tape
	SK_IF_ERR() SEARCH(loop2)
	SEARCH(done)
MARK(loop2)
	ST_DIR(convY)

	// track min/max...
	RE_Y_DIR(maxY)
	SK_IF_GE() ST_DIR(maxY)
	RE_Y_DIR(minY)
	SK_IF_LT() ST_DIR(minY)

	FCALL(setup_point)
	FCALL(plot_drawto)
	ENTER(1)
	ADD_DIR(currX)
	SEARCH(loop3)

// Need to trap End Of Tape from 703: SR 0000...
MARK(PAPERTAPE_END)
	ENTER(0)
	INV()
	RETURN()

END()
