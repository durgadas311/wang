#include "wang700.h"

#include "plotter.w7h"	// get out interface to the world

FLABEL(plot_Xaxis)

FEXTERNAL(plot_moveto)
FEXTERNAL(plot_drawto)
FEXTERNAL(setup_point)

// Local Labels:
LLABEL(loop)
LLABEL(resid)
FLLABEL(plot_tic)

BEGIN()
MARK(plot_Xaxis)
	ENTER(1)
	FCALL(plot_chrsize) // so we know label offsets...
	// X,Y still contain plot coords...
	RE_DIR(plotX)
	ST_DIR(temp6) // hope no one trashes this...
	ENTER(3)
	MULT_DIR(temp6)	// label width
	RE_DIR(plotY)
	ST_DIR(temp5)

	// do first point as "move", not "plot"
	FCALL(plot_home)
	ENTER(0)
	ST_DIR(lastX)
	ST_DIR(lastY)
	RE_DIR(startX)
	ST_DIR(currX)
	ST_DIR(convX)
	RE_DIR(currY)
	ST_DIR(convY)
	FCALL(setup_point)
	FCALL(plot_moveto)
	FCALL(plot_tic)
	RE_DIR(stepX)
	ADD_DIR(currX)
	// could check limits here, for completeness, but nothing was drawn...
MARK(loop)
	RE_DIR(currX)
	ST_DIR(convX)
	RE_DIR(currY)
	ST_DIR(convY)
	FCALL(setup_point)
	FCALL(plot_drawto)
	FCALL(plot_tic)
	RE_DIR(maxX)
	ST_DIR(temp1)
	RE_DIR(stepX)
	ADD_DIR(currX)
	RE_DIR(currX)
	SUB_DIR(temp1)
	RE_DIR(temp1)
	SK_IF_XP() SEARCH(resid)
	SEARCH(loop)

MARK(resid)
	RE_DIR(stepX)
	ADD_DIR(temp1)
	RE_DIR(temp1)
	SK_IF_XN0() RETURN() GO()
	RE_DIR(maxX)
	ST_DIR(convX)
	RE_DIR(currY)
	ST_DIR(convY)
	FCALL(setup_point)
	FCALL(plot_drawto)
	RETURN()

MARK(plot_tic)
	ENTER(0)
	ST_DIR(plotX)
	ENTER(-5)	// scale?
	ST_DIR(plotY)
	FCALL(plot_drawto)
	RE_DIR(temp6)
	CHANGE_SIGN()
	ST_DIR(plotX)
	RE_DIR(temp5)
	CHANGE_SIGN()
	ST_DIR(plotY)
	FCALL(plot_moveto)
	RE_DIR(currX)
	WRITE(0x30)
	FCALL(plot_home)
	RE_DIR(lastX)
	ST_DIR(plotX)
	RE_DIR(lastY)
	ST_DIR(plotY)
	FCALL(plot_moveto)
	RETURN()
END()
