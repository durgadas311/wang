#include "wang700.h"

#include "libw7/julianday.w7h"

/*
 * Wrapper around David Stokes' Julian Day compute function.
 *
 * PRIME, enter day, GO, enter month, GO, enter year, GO: julian day in X.
 *
 * Example: 1/2/2012 => +2455959.00000
 */

BEGIN()

	ST_DIR(jd_day)
	CLR_X()
	STOP()
	ST_DIR(jd_month)
	CLR_X()
	STOP()
	ST_DIR(jd_year)
	FCALL(julian_day)
	END_PROG()

END()
