; Plot a sine wave on the PlottingOutputWriter.
	.OUT	W702

	; CLRALL	; needed?
	ENTER 0
	STD 12		; clear previous coords
	STD 13
	ENTER 0		; starting X = 0
	STD 16
	ENTER 360	; ending X = 360
	STD 17
	ENTER 1		; step X = 1
	STD 18
	ENTER 1
	STD 21	; X scale = 1
	ENTER 200
	STD 22	; Y scale = 200
	ENTER 0
	STD 19	; X base = 0
	ENTER 300
	STD 20	; Y base = 300
	$grapher
	ENTER 0
	STD 14
	ENTER 1
	STD 15
	$pt_scale	; sets R0,R1
	REYD 00	; 700 needs X/Y not R1/R0
	RED 01
	ALPHA "|  y = SIN(x)"
	SEARCH &exit

; Y = f(X) function.
; On entry, display has X.
; On return, display has the corresponding Y.
MARK SR0-00
	$sinX
	RET

; Plot a point (R1,R0).
; for 702, rotate graph 90 degrees right.
; X axis is down page, Y is left/right.
MARK SR0-01
	REYD 00	; Y = R0
	RED 01	; X = R1
	CHGSGN
	EXY	; (R1,R0) => (R0,-R1)
	ALPHA "|."
	RET

	.INCLUDE	grapher.w7i
	.INCLUDE	pt_scale.w7i
	.INCLUDE	sinX.w7i

MARK &exit
	END
