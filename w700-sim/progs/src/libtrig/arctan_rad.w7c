// compute arc-tangent of angle in radians
#include "wang700.h"

FLABEL(arctan_rad)

BEGIN()
MARK(arctan_rad)
	_ALPHA(CLEAR_X)
	ST_Y()
	ENTER(.5)
	SK_IF_GE() _ALPHA(X_2)
	ENTER(1)
	ADD_Y()
	ST_Y_DIR(113)
	ENTER(2)
	SUB_Y()
	RE_DIR(113)
	DIV_Y()
	RE_Y()
	ST_Y_DIR(112)
	MULT_Y()
	ST_Y_DIR(113)
	ENTER(1)
	ST_DIR(111)
MARK(1513)
	RE_DIR(113)
	MULT_DIR(120)
	RE_DIR(111)
	MULT_DIR(111)
	EXCHG_DIR(111)
	MULT_DIR(120)
	RE_Y()
	ADD_DIR(120)
	ENTER(2)
	SUB_Y()
	ENTER(1)
	SUB_DIR(111)
	EXCHG_DIR(120)
	DIV_DIR(120)
	RE_DIR(111)
	_ALPHA(LOG_E_X)
	SEARCH(1513)
	SK_IF_X0() SEARCH(1513)
	RE_Y_DIR(112)
	RE_DIR(120)
	MULT_Y()
	D180PI()
	MULT_Y()
	ENTER(45)
	_ALPHA(E10_X)
	DPI180()
	MULT_Y()
	RE_Y()
	_ALPHA(END_PROG)
	SEARCH(1515)
	
END()
