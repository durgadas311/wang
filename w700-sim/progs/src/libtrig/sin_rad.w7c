// cos of angle in radians
#include "wang700.h"

FLABEL(sin_rad)

BEGIN()

MARK(sin_rad)
	ST_DIR(120)
	PI()
	ST_Y()
	ADD_Y()
	RE_DIR(120)
	EXCHG_Y()
	DIV_Y()
	EXCHG_Y()
	INT()
	MULT_Y()
	RE_DIR(120)
	EXCHG_Y()
	SUB_Y()
	PI()
	DIV_Y()
	RE_Y()
	INT()
	_ALPHA(LOG_E_X)
	SUB_Y()
	CHANGE_SIGN()
	ENTER(1)
	MULT_Y()
	ENTER(.5)
	SK_IF_LT() SEARCH(1508)
MARK(1507)
	PI()
	MULT_Y()
	ST_Y_DIR(120)
	RE_Y()
	X_2()
	ST_DIR(113)
	ENTER(15)
	ST_Y()
	ENTER(1)
	ST_DIR(112)
MARK(1506)
	RE_DIR(113)
	CHANGE_SIGN()
	EXCHG_DIR(112)
	RE_Y()
	DIV_DIR(112)
	ENTER(1)
	SUB_Y()
	RE_Y()
	DIV_DIR(112)
	ENTER(1)
	ADD_DIR(112)
	RE_RES()
	ADD_DIR(112)
	ENTER(1)
	SUB_Y()
	SK_IF_EQ() SEARCH(1506)
	RE_DIR(112)
	RE_Y_DIR(120)
	MULT_Y()
	RE_Y()
	SEARCH(1515)

MARK(1508)
	SUB_Y()
	SUB_Y()
	RE_Y()
	CHANGE_SIGN()
	ST_Y()
	SEARCH(1507)

END()
