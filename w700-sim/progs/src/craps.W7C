#include "wang700.h"

FLLABEL(rand)
FLLABEL(roll_dice)
LLABEL(new_game)
LLABEL(lose)
LLABEL(win)
LLABEL(try_point)
LLABEL(no_funds)


LLABEL(new_game1)
LLABEL(new_game2)
LLABEL(new_game3)
LLABEL(new_game4)
LLABEL(try_point1)


RES_REG(seed, 7)
RES_REG(compare, 0)
RES_REG(bank, 1)
RES_REG(bet, 2)
RES_REG(roll, 3)
RES_REG(temp2, 14)
RES_REG(temp, 15)

IREG_DATA(blank,"ffffffffffffffff")

BEGIN()
	ST_DIR(seed)
	ENTER(500)
	ST_DIR(bank)
MARK(new_game)
	RE_Y_DIR(bank)
	CLR_X()
	STOP()
	ST_DIR(bet)
	SUB_Y()
	SK_IF_YP()
	SEARCH(no_funds)
	FCALL(roll_dice)
	ST_DIR(compare)
	ST_Y()
	PAUSE()
	PAUSE()
	ENTER(12)
	SK_IF_EQ()
	SEARCH(new_game1)
	SEARCH(lose)
MARK(new_game1)
	ENTER(2)
	SK_IF_EQ()
	SEARCH(new_game2)
	SEARCH(lose)
MARK(new_game2)
	ENTER(3)
	SK_IF_EQ()
	SEARCH(new_game3)
	SEARCH(lose)
MARK(new_game3)
	ENTER(7)
	SK_IF_EQ()
	SEARCH(new_game4)
	SEARCH(win)
MARK(new_game4)
	ENTER(11)
	SK_IF_EQ()
	SEARCH(try_point)
	SEARCH(win)

MARK(try_point)
	FCALL(roll_dice)
	RE_Y_DIR(compare)
	PAUSE()
	PAUSE()
	SK_IF_EQ()
	SEARCH(try_point1)
	SEARCH(win)
MARK(try_point1)
	ST_Y()
	ENTER(7)
	SK_IF_EQ()
	SEARCH(try_point)

MARK(lose)
	RE_DIR(blank)
	RE_Y_DIR(blank)
	PAUSE()
	RE_DIR(bet)
	SUB_DIR(bank)
	SEARCH(new_game)

MARK(win)
	ENTER(0)
	INV()
	RE_DIR(compare)
	PAUSE()
	SK_IF_ERR()
	GO()
	GO()
	RE_DIR(bet)
	ADD_DIR(bank)
	SEARCH(new_game)

MARK(no_funds)
	ENTER(0)
	INV()
	RE_DIR(bank)
	PAUSE()
	SK_IF_ERR()
	GO()
	GO()
	SEARCH(new_game)

MARK(roll_dice)
	FCALL(rand)
	ST_Y()
	ENTER(6)
	MULT_Y()
	ENTER(1)
	ADD_Y()
	RE_Y()
	INT()
	ST_DIR(roll)
	FCALL(rand)
	ST_Y()
	ENTER(6)
	MULT_Y()
	ENTER(1)
	ADD_Y()
	RE_Y()
	INT()
	ADD_DIR(roll)
	RE_DIR(roll)
	RETURN()

MARK(rand)
	ENTER(1)
	ADD_DIR(seed)
	RE_DIR(seed)
	POW10(7)
	LOG_E_X()
	MULT_DIR(seed)
	RE_DIR(seed)
	INT()
	SUB_DIR(seed)
	RE_DIR(seed)
	RETURN()
END()
