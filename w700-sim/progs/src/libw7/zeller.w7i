; perform "Zeller's Congruence" calculation
; R0 = month 1..12
; R1 = day 1..31(*)
; R2 = year YYYY
; R3 = temp
; z = (day+INT(2.6*(mon+1))+(year%100)+INT((year%100)/4)+INT(year/100)*5+INT(year/400))%7
; z = INT(z+0.5)

MARK $zeller
	REYD 00	; month 1..12
	ENTER 3
	SKY>=X	; R0 >= 3
		SEARCH &zc0	; correct for Jan/Feb
MARK &zc1	; got correct month/year now
	ENTER 1
	+D 00
	ENTER 26
	*D 00
	ENTER 10
	/D 00
	RED 00
	INT
	+D 01
	ENTER 100
	/D 02
	RED 02
	INT
	STD 03
	-D 02
	ENTER 100
	*D 02
	RED 02
	+D 01
	ENTER 4
	/D 02
	RED 02
	INT
	+D 01
	RED 03
	STD 02
	ENTER 5
	*D 02
	RED 02
	+D 01
	ENTER 4
	/D 03
	RED 03
	INT
	+D 01
	ENTER 7
	/D 01
	RED 01
	INT
	-D 01
	ENTER 7
	*D 01
	ENTER .5
	+D 01
	RED 01
	INT
	RET

MARK &zc0	; convert Jan/Feb to 13/14 of previous year
	ENTER 12
	+D 00
	ENTER 1
	-D 02
	SEARCH &zc1
