
#include "wang700.h"
#include "zeller.w7h"

FLABEL(zeller)
LLABEL(pre_march)
LLABEL(rejoin)

BEGIN()
MARK(zeller)
	RE_Y_DIR(month)
	ENTER(3)
	SK_IF_GE()
	SEARCH(pre_march)
MARK(rejoin)
	RE_Y_DIR(month)
	ENTER(1)
	ADD_Y()
	ENTER(26)
	MULT_Y()
	ENTER(10)
	DIV_Y()
	EXCHG_Y()
	INT()
	ADD_DIR(day)

	RE_Y_DIR(year)
	ENTER(100)
	DIV_Y()
	RE_Y()
	INT()
	ST_DIR(temp)
	SUB_Y()
	ENTER(100)
	MULT_Y()
	RE_Y()
	ADD_DIR(day)

	ENTER(4)
	DIV_Y()
	RE_Y()
	INT()
	ADD_DIR(day)

	RE_Y_DIR(temp)
	ENTER(5)
	MULT_Y()
	RE_Y()
	ADD_DIR(day)

	RE_Y_DIR(temp)
	ENTER(4)
	DIV_Y()
	RE_Y()
	INT()
	ADD_DIR(day)

	RE_Y_DIR(day)
	ENTER(7)
	DIV_Y()
	RE_Y()
	INT()
	SUB_Y()
	ENTER(7)
	MULT_Y()
	ENTER(.5)
	ADD_Y()
	RE_Y()
	INT()
	RETURN()

MARK(pre_march)
	ENTER(12)
	ADD_DIR(month)
	ENTER(1)
	SUB_DIR(year)
	SEARCH(rejoin)
END()
