	DIV_DIR(month)
	RE_DIR(month)
	INT()
	ADD_DIR(day)
	ENTER(100)
	DIV_DIR(year)
	RE_DIR(year)
	INT()
	ST_DIR(temp)
	SUB_DIR(year)
	ENTER(100)
	MULT_DIR(year)
	RE_DIR(year)
	ADD_DIR(day)
	ENTER(4)
	DIV_DIR(year)
	RE_DIR(year)
	INT()
	ADD_DIR(day)
	RE_DIR(temp)
	ST_DIR(year)
	ENTER(5)
	MULT_DIR(year)
	RE_DIR(year)
	ADD_DIR(day)
