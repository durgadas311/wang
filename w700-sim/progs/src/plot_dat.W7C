#include "wang700.h"

#include "libplot/plotter.w7h"

BEGIN()
	ENTER(5)	// scaling in X
	ST_DIR(scaleX)
	ENTER(10)	// scaling in Y
	ST_DIR(scaleY)
	ENTER(40)	// translation in X
	ST_DIR(tranX)
	ENTER(200)	// translation in Y
	ST_DIR(tranY)

	ENTER(0)
	ST_DIR(startX)
	FCALL(plot_data)	// sets maxX, minY, maxY for us...

	RE_Y_DIR(maxX)
	RE_DIR(startX)
	SUB_Y()
	ENTER(1)
	ADD_Y()
	ST_Y_DIR(maxX)
	ENTER(0)
	ST_DIR(startX)
	ENTER(8)
	ST_DIR(stepX)
	ENTER(0)
	ST_DIR(currY)
	FCALL(plot_Xaxis)

	RE_Y_DIR(minY)
	ENTER(5)	// 4.999999999...
	SK_IF_YP() CHANGE_SIGN() GO()
	ADD_Y()
	ENTER(5)
	DIV_Y()
	EXCHG_Y()
	INT()
	EXCHG_Y()
	MULT_Y()	// X still has 5
	ST_Y_DIR(startX)
	// make sure we plot the last point
	RE_Y_DIR(maxY)
	ENTER(5)	// 4.999999999...
	SK_IF_YP() CHANGE_SIGN() GO()
	ADD_Y()
	ENTER(5)
	DIV_Y()
	EXCHG_Y()
	INT()
	EXCHG_Y()
	MULT_Y()	// X still has 5
	ENTER(1)
	SK_IF_YP() CHANGE_SIGN() GO()
	ADD_Y()
	ST_Y_DIR(maxX)
	ENTER(5)
	ST_DIR(stepX)
	ENTER(0)
	ST_DIR(currX)
	FCALL(plot_Yaxis)

	ENTER(2)
	FCALL(plot_chrsize)
	ENTER(0)
	ST_DIR(convX)
	ENTER(-17)
	ST_DIR(convY)
	FCALL(setup_point)
	FCALL(plot_moveto)
	ALPHA_PLOT("OUTDOOR TEMP, DEG C")
	END_PROG()
END()
